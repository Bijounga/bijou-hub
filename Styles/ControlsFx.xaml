<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The "fx" template set — the wallpaper-and-floating-panel looks (Frutiger Aero, MS-DOS,
         Vaporwave, Y2K Chrome, ...), modelled on Bijou Footage's themes-fx.css: a wallpaper
         behind everything, the sidebar and content floating on it as glass or bevelled plates,
         and every control drawn from a theme's materials (the Fx* resources below, which each
         theme overrides, like the CSS fx custom properties).

         Every control keeps its text on its own layer above the surface that carries a shadow
         or glow: WPF renders anything inside an element with an Effect without ClearType, so
         putting the effect on a sibling keeps labels crisp. -->

    <!-- ===== Shell: panels float on the wallpaper ===== -->
    <Thickness x:Key="ShellPadding">8</Thickness>
    <Thickness x:Key="SidebarMargin">0,0,8,0</Thickness>
    <Thickness x:Key="SidebarBorderThickness">1</Thickness>
    <Thickness x:Key="ContentBorderThickness">1</Thickness>
    <CornerRadius x:Key="PanelRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelTopRadius">11,11,0,0</CornerRadius>
    <Thickness x:Key="PanelInset">1</Thickness>
    <Thickness x:Key="SidebarHeaderBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="SidebarHeaderPadding">14,8,14,8</Thickness>
    <Thickness x:Key="SidebarBodyMargin">16,14,16,16</Thickness>
    <Thickness x:Key="ContentMargin">24</Thickness>

    <!-- ===== Material defaults (every fx theme overrides most of these) ===== -->
    <SolidColorBrush x:Key="FxBtnBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="{DynamicResource BorderColor}"/>
    <Thickness x:Key="FxBtnBorderThickness">1</Thickness>
    <CornerRadius x:Key="FxBtnRadius">8</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">12</CornerRadius>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="FxBtnSheenBrush" Color="Transparent"/>
    <x:Null x:Key="FxBtnShadow"/>
    <x:Null x:Key="FxBtnHoverEffect"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="FxPrimaryWashBrush" Color="#1AFFFFFF"/>
    <TranslateTransform x:Key="FxPressTransform" X="0" Y="0"/>
    <SolidColorBrush x:Key="FxPrimaryBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="{DynamicResource BgColor}"/>
    <x:Null x:Key="FxPrimaryShadow"/>
    <x:Null x:Key="FxPrimaryHoverEffect"/>

    <Visibility x:Key="FxBevelVisibility">Collapsed</Visibility>
    <SolidColorBrush x:Key="FxBevelOuterLightBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelOuterDarkBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelInnerLightBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelInnerDarkBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelPressedOuterLightBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelPressedOuterDarkBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelPressedInnerLightBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelPressedInnerDarkBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelSunkenOuterLightBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelSunkenOuterDarkBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelSunkenInnerLightBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxBevelSunkenInnerDarkBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="FxRowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="Transparent"/>
    <Thickness x:Key="FxRowBorderThickness">1</Thickness>
    <CornerRadius x:Key="FxRowRadius">8</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="FxSelectedBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="{DynamicResource AccentColor}"/>
    <Thickness x:Key="FxSelectedBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="{DynamicResource BgColor}"/>
    <x:Null x:Key="FxSelectedGlow"/>

    <SolidColorBrush x:Key="FxFieldBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="{DynamicResource BorderColor}"/>
    <Thickness x:Key="FxFieldBorderThickness">1</Thickness>
    <CornerRadius x:Key="FxFieldRadius">8</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="{DynamicResource AccentColor}"/>
    <x:Null x:Key="FxFieldFocusGlow"/>

    <SolidColorBrush x:Key="FxPopupBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="{DynamicResource BorderColor}"/>
    <CornerRadius x:Key="FxPopupRadius">8</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>

    <SolidColorBrush x:Key="FxCheckBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="{DynamicResource BorderColor}"/>
    <CornerRadius x:Key="FxCheckRadius">4</CornerRadius>
    <SolidColorBrush x:Key="FxCheckOnBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="{DynamicResource BgColor}"/>

    <SolidColorBrush x:Key="FxThumbBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FxThumbEdgeBrush" Color="Transparent"/>
    <Thickness x:Key="FxThumbBorderThickness">0</Thickness>
    <CornerRadius x:Key="FxThumbRadius">5</CornerRadius>
    <SolidColorBrush x:Key="FxTrackBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="FxScrewHeadBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="FxScrewRimBrush" Color="#7D848E"/>
    <SolidColorBrush x:Key="FxScrewSlotBrush" Color="#565C64"/>

    <!-- A slotted screw head, for the corners of screwed-down panels (Y2K themes). -->
    <DrawingImage x:Key="ScrewImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource FxScrewRimBrush}">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="5,5" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource FxScrewHeadBrush}">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="5,5" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource FxScrewSlotBrush}" Thickness="1.1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><LineGeometry StartPoint="3.2,6.8" EndPoint="6.8,3.2"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ===== Buttons ===== -->
    <ControlTemplate x:Key="FxButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource FxBtnRadius}" Effect="{DynamicResource FxBtnShadow}"/>
            <Border CornerRadius="{DynamicResource FxBtnRadius}" BorderThickness="0,1,0,0" Margin="1"
                    BorderBrush="{DynamicResource FxBtnSheenBrush}" IsHitTestVisible="False"/>
            <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                <Border x:Name="BevelOTL" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelOuterLightBrush}"/>
                <Border x:Name="BevelOBR" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelOuterDarkBrush}"/>
                <Border x:Name="BevelITL" BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelInnerLightBrush}"/>
                <Border x:Name="BevelIBR" BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelInnerDarkBrush}"/>
            </Grid>
            <Border x:Name="Wash" CornerRadius="{DynamicResource FxBtnRadius}" Background="{DynamicResource FxHoverWashBrush}"
                    Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                    <!-- Base.xaml's implicit TextBlock style pins Foreground to TextBrush; a closer
                         implicit style lets string content follow this button's own Foreground. -->
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource FxBtnHoverEffect}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource FxPressWashBrush}"/>
                <Setter TargetName="Root" Property="RenderTransform" Value="{DynamicResource FxPressTransform}"/>
                <Setter TargetName="BevelOTL" Property="BorderBrush" Value="{DynamicResource FxBevelPressedOuterLightBrush}"/>
                <Setter TargetName="BevelOBR" Property="BorderBrush" Value="{DynamicResource FxBevelPressedOuterDarkBrush}"/>
                <Setter TargetName="BevelITL" Property="BorderBrush" Value="{DynamicResource FxBevelPressedInnerLightBrush}"/>
                <Setter TargetName="BevelIBR" Property="BorderBrush" Value="{DynamicResource FxBevelPressedInnerDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="Background" Value="{DynamicResource FxBtnBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FxBtnEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource FxBtnBorderThickness}"/>
        <Setter Property="Foreground" Value="{DynamicResource FxBtnInkBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FxButtonTemplate}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>

    <!-- Primary action: the theme's "on" material. Same shape, its own resting glow. -->
    <ControlTemplate x:Key="FxPrimaryTemplate" TargetType="Button">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource FxBtnRadius}" Effect="{DynamicResource FxPrimaryShadow}"/>
            <Border CornerRadius="{DynamicResource FxBtnRadius}" BorderThickness="0,1,0,0" Margin="1"
                    BorderBrush="{DynamicResource FxBtnSheenBrush}" IsHitTestVisible="False"/>
            <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                <Border x:Name="BevelOTL" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelOuterLightBrush}"/>
                <Border x:Name="BevelOBR" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelOuterDarkBrush}"/>
                <Border x:Name="BevelITL" BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelInnerLightBrush}"/>
                <Border x:Name="BevelIBR" BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelInnerDarkBrush}"/>
            </Grid>
            <Border x:Name="Wash" CornerRadius="{DynamicResource FxBtnRadius}" Background="{DynamicResource FxPrimaryWashBrush}"
                    Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource FxPrimaryHoverEffect}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource FxPressWashBrush}"/>
                <Setter TargetName="Root" Property="RenderTransform" Value="{DynamicResource FxPressTransform}"/>
                <Setter TargetName="BevelOTL" Property="BorderBrush" Value="{DynamicResource FxBevelPressedOuterLightBrush}"/>
                <Setter TargetName="BevelOBR" Property="BorderBrush" Value="{DynamicResource FxBevelPressedOuterDarkBrush}"/>
                <Setter TargetName="BevelITL" Property="BorderBrush" Value="{DynamicResource FxBevelPressedInnerLightBrush}"/>
                <Setter TargetName="BevelIBR" Property="BorderBrush" Value="{DynamicResource FxBevelPressedInnerDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource FxPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FxPrimaryEdgeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FxPrimaryInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template" Value="{StaticResource FxPrimaryTemplate}"/>
    </Style>

    <Style x:Key="QuickLaunchTileStyle" TargetType="Button">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="104"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource FxBtnBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FxBtnEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource FxBtnBorderThickness}"/>
        <Setter Property="Foreground" Value="{DynamicResource FxBtnInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource FxTileRadius}" Effect="{DynamicResource FxBtnShadow}"/>
                        <Border CornerRadius="{DynamicResource FxTileRadius}" BorderThickness="0,1,0,0" Margin="1"
                                BorderBrush="{DynamicResource FxBtnSheenBrush}" IsHitTestVisible="False"/>
                        <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                            <Border x:Name="BevelOTL" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelOuterLightBrush}"/>
                            <Border x:Name="BevelOBR" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelOuterDarkBrush}"/>
                            <Border x:Name="BevelITL" BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelInnerLightBrush}"/>
                            <Border x:Name="BevelIBR" BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelInnerDarkBrush}"/>
                        </Grid>
                        <Border x:Name="Wash" CornerRadius="{DynamicResource FxTileRadius}" Background="{DynamicResource FxHoverWashBrush}"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                            <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource FxBtnHoverEffect}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wash" Property="Background" Value="{DynamicResource FxPressWashBrush}"/>
                            <Setter TargetName="Root" Property="RenderTransform" Value="{DynamicResource FxPressTransform}"/>
                            <Setter TargetName="BevelOTL" Property="BorderBrush" Value="{DynamicResource FxBevelPressedOuterLightBrush}"/>
                            <Setter TargetName="BevelOBR" Property="BorderBrush" Value="{DynamicResource FxBevelPressedOuterDarkBrush}"/>
                            <Setter TargetName="BevelITL" Property="BorderBrush" Value="{DynamicResource FxBevelPressedInnerLightBrush}"/>
                            <Setter TargetName="BevelIBR" Property="BorderBrush" Value="{DynamicResource FxBevelPressedInnerDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text fields ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="Background" Value="{DynamicResource FxFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FxFieldInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FxFieldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource FxFieldBorderThickness}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FxFieldInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource FxFieldRadius}"/>
                        <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelSunkenOuterLightBrush}"/>
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelSunkenOuterDarkBrush}"/>
                            <Border BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelSunkenInnerLightBrush}"/>
                            <Border BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelSunkenInnerDarkBrush}"/>
                        </Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FxFieldFocusBrush}"/>
                            <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource FxFieldFocusGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource FxFieldInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource FxRowRadius}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FxRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FxSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FxSelectedInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="Background" Value="{DynamicResource FxFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FxFieldInkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FxFieldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource FxFieldBorderThickness}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource FxFieldRadius}"/>
                        <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelSunkenOuterLightBrush}"/>
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelSunkenOuterDarkBrush}"/>
                            <Border BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelSunkenInnerLightBrush}"/>
                            <Border BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelSunkenInnerDarkBrush}"/>
                        </Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource FxFieldInkBrush}" Opacity="0.7"
                                              StrokeThickness="1.5" StrokeLineJoin="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide">
                            <Grid Margin="0,2,10,12">
                                <Border Background="{DynamicResource FxPopupBrush}" BorderBrush="{DynamicResource FxPopupEdgeBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource FxPopupRadius}"
                                        Effect="{DynamicResource FxPopupShadow}"/>
                                <ScrollViewer Margin="3" MaxHeight="220" SnapsToDevicePixels="True"
                                              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FxFieldFocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="19" Height="19" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border x:Name="Box" Background="{DynamicResource FxCheckBrush}" BorderBrush="{DynamicResource FxCheckEdgeBrush}"
                                    BorderThickness="1.5" CornerRadius="{DynamicResource FxCheckRadius}"/>
                            <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                                <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelSunkenOuterLightBrush}"/>
                                <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelSunkenOuterDarkBrush}"/>
                                <Border BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelSunkenInnerLightBrush}"/>
                                <Border BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelSunkenInnerDarkBrush}"/>
                            </Grid>
                            <Path x:Name="Check" Data="M2,7 L7,12 L15,2" Stroke="{DynamicResource FxCheckMarkBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource FxCheckOnBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FxCheckOnEdgeBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FxFieldFocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Surface" Background="{DynamicResource FxRowBrush}" BorderBrush="{DynamicResource FxRowEdgeBrush}"
                                BorderThickness="{DynamicResource FxRowBorderThickness}" CornerRadius="{DynamicResource FxRowRadius}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FxRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FxSelectedBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FxSelectedEdgeBrush}"/>
                            <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FxSelectedBorderThickness}"/>
                            <Setter TargetName="Surface" Property="Effect" Value="{DynamicResource FxSelectedGlow}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FxSelectedInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbars ===== -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Margin="2" SnapsToDevicePixels="True">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource FxThumbBrush}" BorderBrush="{DynamicResource FxThumbEdgeBrush}"
                                BorderThickness="{DynamicResource FxThumbBorderThickness}" CornerRadius="{DynamicResource FxThumbRadius}" Opacity="0.75"/>
                        <Grid Visibility="{DynamicResource FxBevelVisibility}" IsHitTestVisible="False">
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FxBevelOuterLightBrush}"/>
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FxBevelOuterDarkBrush}"/>
                            <Border BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource FxBevelInnerLightBrush}"/>
                            <Border BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource FxBevelInnerDarkBrush}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource FxTrackBrush}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
