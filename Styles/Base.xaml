<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles that never change regardless of which interactive-control template set
         (Styles/Controls.xaml "calm" vs Styles/ControlsNerv.xaml "classic") is active —
         always merged at a fixed slot, never swapped. -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Ambient header glow — only shown by the NERV Classic theme (MainWindow.AmbientGlow),
         but defined here (not per-theme) so it always resolves from whichever theme is
         active, computed off that theme's own accent. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Hazard-stripe texture — only used by the NERV Classic theme's project progress
         bar fill (MainWindow.xaml), kept here rather than in ControlsNerv.xaml since it's
         a brush resource, not a control template. Color-matched to the active accent. -->
    <DrawingBrush x:Key="HazardHatchBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,10,10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#40000000">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M0,10 L10,0 L10,3 L3,10 Z M0,3 L3,0 L0,0 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
