{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.bijounga.bijouhub",
	"Name": "BijouHub",
	"Version": "1.3.0.0",
	"Author": "Bijou",
	"Description": "BijouHub on your Stream Deck: start timers, watch the running session, work through today's goals and add time.",
	"Icon": "imgs/plugin",
	"Category": "BijouHub",
	"CategoryIcon": "imgs/category",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "disabled"
	},
	"Actions": [
		{
			"UUID": "com.bijounga.bijouhub.timer",
			"Name": "Timer",
			"Icon": "imgs/action",
			"Tooltip": "Starts a BijouHub timer in a mode. Tap to pause, hold to finish.",
			"PropertyInspectorPath": "ui/timer.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bijounga.bijouhub.session",
			"Name": "Current Session",
			"Icon": "imgs/session",
			"Tooltip": "Shows the running session from anywhere. Tap to pause, hold to finish. Idle: today's total; tap opens BijouHub.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/session-key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bijounga.bijouhub.goal",
			"Name": "Next Goal",
			"Icon": "imgs/goal",
			"Tooltip": "Today's goals, starred first. Tap for the next one, hold to check it off.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/goal-key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bijounga.bijouhub.extend",
			"Name": "Add Time",
			"Icon": "imgs/extend",
			"Tooltip": "Adds minutes to the running session's countdown.",
			"PropertyInspectorPath": "ui/extend.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/extend-key",
					"ShowTitle": false
				}
			]
		},
		{
			"UUID": "com.bijounga.bijouhub.popout",
			"Name": "Pop Out Timer",
			"Icon": "imgs/popout",
			"Tooltip": "Pops BijouHub's mini timer out on top of other apps, or docks it again.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/popout-key",
					"ShowTitle": false
				}
			]
		}
	]
}