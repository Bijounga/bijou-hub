<Application x:Class="BijouHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BijouHub"
             xmlns:conv="clr-namespace:BijouHub.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Later dictionaries win, so this order is most-general to most-specific:
                     [0] Base — shared styles plus the default value of every look resource;
                     never swapped.
                     [1] the active control-template set (Styles/Controls, ControlsNerv or
                     ControlsFx) — swapped by Services/ThemeService.Apply.
                     [2] the active theme — swapped by ThemeService.Apply too, and last so its
                     values override both. Declared with defaults so design-time and a
                     first-ever run still resolve every DynamicResource. -->
                <ResourceDictionary Source="Styles/Base.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:IndexToBrushConverter x:Key="IndexToBrushConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

            <!-- Brand mark (the sidebar "gem" logo) — a fixed identity color, not a theme
                 token, the same way a real logo doesn't recolor itself per app theme. -->
            <LinearGradientBrush x:Key="GemGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#EAF6FF" Offset="0.5"/>
                <GradientStop Color="#A8D8F0" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
