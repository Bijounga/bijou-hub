<Application x:Class="BijouHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BijouHub"
             xmlns:conv="clr-namespace:BijouHub.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active theme (colors/fonts/radius) — Services/ThemeService.Apply
                     replaces this entry at runtime. Declared here as the default so design-time
                     and a first-ever run (before any setting is read) still resolve every
                     DynamicResource token. -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <!-- Index 1: Window/TextBlock/HeadingText — never swapped, shared by every
                     theme and every control-template set below. -->
                <ResourceDictionary Source="Styles/Base.xaml"/>
                <!-- Index 2: the active interactive-control template set — also swapped by
                     ThemeService.Apply, paired with whichever theme is selected (the calm set
                     by default; Styles/ControlsNerv.xaml for the "NervClassic" theme). -->
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:IndexToBrushConverter x:Key="IndexToBrushConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Brand mark (the sidebar "gem" logo) — a fixed identity color, not a theme
                 token, the same way a real logo doesn't recolor itself per app theme. -->
            <LinearGradientBrush x:Key="GemGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#EAF6FF" Offset="0.5"/>
                <GradientStop Color="#A8D8F0" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
