<Window x:Class="BijouHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BijouHub"
        mc:Ignorable="d"
        Title="BijouHub" Height="820" Width="1280" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app-icon.ico"
        Background="{DynamicResource BgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="AppScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
            <Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24" Cursor="Hand" MouseLeftButtonDown="HomeHeader_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,8">
                        <Polygon Points="6,0 18,0 24,8 18,16 6,16 0,8"
                                 Fill="{StaticResource GemGradientBrush}"
                                 Stroke="#071018" StrokeThickness="1.2" StrokeLineJoin="Round"
                                 Width="24" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BijouHub" Style="{StaticResource HeadingText}" FontSize="19" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="// MODES" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="4,0,0,8"/>

                <ListBox x:Name="ModesList" Grid.Row="2"
                         AlternationCount="3"
                         SelectionChanged="ModesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToBrushConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3" Content="+ New Mode" Style="{StaticResource AccentButton}" Margin="0,8,8,0" Padding="10,8" Click="NewMode_Click"/>

                <TextBlock Grid.Row="4" Text="// PROJECTS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="4,16,0,8"/>

                <ListBox x:Name="ProjectsList" Grid.Row="5"
                         AlternationCount="3"
                         SelectionChanged="ProjectsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToBrushConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="6" Content="+ New Project" Style="{StaticResource AccentButton}" Margin="0,8,0,0" Padding="10,8" Click="NewProject_Click"/>
                <Button Grid.Row="7" Content="Session Log" Margin="0,8,0,0" Click="SessionLog_Click"/>
                <Button x:Name="SyncFolderButton" Grid.Row="8" Content="Sync Folder..." Margin="0,8,0,0" Click="SyncFolder_Click"
                        ToolTip="Point Projects and session history at a folder you sync across devices"/>
                <Button x:Name="StartupToggleButton" Grid.Row="9" Content="Start on Startup" Margin="0,8,0,0" Click="StartupToggle_Click"
                        ToolTip="Launch BijouHub automatically when you sign in to Windows"/>
                <Button x:Name="ThemeButton" Grid.Row="10" Content="Theme..." Margin="0,8,0,0" Click="OpenTheme_Click"
                        ToolTip="Choose BijouHub's color theme"/>
                <Button x:Name="UpdateButton" Grid.Row="11" Style="{StaticResource AccentButton}" Margin="0,8,0,0" Padding="10,8"
                        Click="UpdateButton_Click" Visibility="Collapsed"/>
            </Grid>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="ActiveSessionBanner" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="12,7"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                    MouseLeftButtonDown="ActiveSessionBanner_Click" Panel.ZIndex="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="ActiveSessionBannerText" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text="  ·  click to return" Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="11,0 33,0 44,15 33,30 11,30 0,15"
                         Fill="{StaticResource GemGradientBrush}"
                         Stroke="#071018" StrokeThickness="1.5" StrokeLineJoin="Round"
                         Width="44" Height="30" Opacity="0.45" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Select a mode, or create one to get started."
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Mode detail (idle, not launched) -->
            <StackPanel x:Name="ModeDetailPanel" Visibility="Collapsed">
                <TextBlock x:Name="ModeDetailName" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,20"/>

                <TextBlock Text="// LAUNCH ITEMS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ModeDetailLaunchItems" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="10,7" Margin="0,0,0,6">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="// BLOCKED" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ModeDetailBlockItems" Margin="0,0,0,28">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="10,7" Margin="0,0,0,6">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding ProcessName}"/>
                                    <TextBlock Text="HARD BLOCK" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Visibility="{Binding IsHardBlock, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <Button Content="▶  Launch" Style="{StaticResource AccentButton}" Padding="20,9" Click="Launch_Click"/>
                    <Button Content="Edit" Margin="8,0,0,0" Padding="16,9" Click="EditMode_Click"/>
                    <Button Content="Delete" Margin="8,0,0,0" Padding="16,9" Click="DeleteMode_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Active session -->
            <StackPanel x:Name="ActiveSessionPanel" Visibility="Collapsed">
                <TextBlock x:Name="ActiveModeName" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,4"/>
                <TextBlock x:Name="ActiveContextText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock x:Name="ActiveStatus" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,24"/>

                <TextBlock x:Name="TimerDisplay" Style="{StaticResource HeadingText}" Text="00:00:00" FontSize="52"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,28"/>

                <TextBlock Text="// ACTIVITY" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                <StackPanel x:Name="BlockNotifications" Margin="0,0,0,28"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="■  Finish Session" Padding="16,8" Click="FinishSession_Click"/>
                    <Button x:Name="NotesToggleButton" Content="Notes" Margin="8,0,0,0" Padding="16,8" Click="NotesToggle_Click"/>
                    <Button x:Name="PopoutToggleButton" Content="Pop Out" Margin="8,0,0,0" Padding="16,8" Click="PopoutToggle_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Project detail -->
            <ScrollViewer x:Name="ProjectDetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="380" HorizontalAlignment="Left">
                        <TextBlock x:Name="ProjectDetailName" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,12"/>

                        <Border Width="320" Height="14" CornerRadius="7" Background="{DynamicResource CardBrush}"
                                HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Border x:Name="ProjectProgressFill" Width="0" Height="14" CornerRadius="7"
                                    Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock x:Name="ProjectProgressLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ProjectTimeSpentText" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,20"/>

                        <TextBlock Text="// GOALS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="ProjectGoalsDisplay" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" Padding="10,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete, Mode=OneWay}"
                                                              Margin="0,0,8,0" Tag="{Binding}"
                                                              Checked="GoalCheckBox_Changed" Unchecked="GoalCheckBox_Changed">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SubGoals.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Completion, StringFormat={}{0:P0}}"
                                                               Foreground="{DynamicResource HazardBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SubGoals.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding Weight, StringFormat={}{0}%}"
                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SubGoals}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{DynamicResource HazardBrush}" Margin="0,0,8,0"/>
                                                                <Grid Grid.Column="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete, Mode=OneWay}"
                                                                              Margin="0,0,8,0" Tag="{Binding}"
                                                                              Checked="GoalCheckBox_Changed" Unchecked="GoalCheckBox_Changed"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Weight, StringFormat={}{0}%}"
                                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="▶  Start Session" Style="{StaticResource AccentButton}" Padding="20,9" Click="StartProjectSession_Click" Margin="0,0,8,8"/>
                            <Button Content="Log Time..." Padding="16,9" Click="LogTime_Click" Margin="0,0,8,8"
                                    ToolTip="Add a session you worked without the timer running"/>
                            <Button Content="Edit" Padding="16,9" Click="EditProject_Click" Margin="0,0,8,8"/>
                            <Button Content="Delete" Padding="16,9" Click="DeleteProject_Click" Margin="0,0,8,8"/>
                            <Button x:Name="ProjectNotesToggleButton" Content="Hide Notes" Padding="16,9" Click="NotesToggle_Click" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock Text="// SESSION LOG" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="ProjectNotesDisplay">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
            </ScrollViewer>

            <!-- Home dashboard -->
            <ScrollViewer x:Name="HomePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="HomeWelcomeText" Style="{StaticResource HeadingText}" Text="Welcome back" FontSize="28" Margin="0,0,0,4"/>
                    <TextBlock x:Name="HomeGreetingText" FontSize="16" Margin="0,0,0,24" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <TextBlock Text="// QUICK LAUNCH" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="QuickLaunchPanel" Margin="0,0,0,24"/>

                    <TextBlock Text="// TODAY" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                    <TextBlock x:Name="HomeTodayText" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="HomeWeekText" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,0,0,24"/>

                    <TextBlock Text="// PROJECTS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="HomeProjectsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="12,10" Margin="0,0,0,8"
                                        Cursor="Hand" MouseLeftButtonDown="HomeProjectRow_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NextGoalSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CompletionPercentText}"
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- Shared notes panel: toggleable, shown alongside Project Detail or Active Session -->
            <StackPanel x:Name="NotesPanel" Grid.Column="1" Width="420" Margin="24,0,0,0" Visibility="Collapsed">
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="// MY NOTES" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Button Content="Keybinds" DockPanel.Dock="Right" Padding="8,3" Click="OpenKeybinds_Click"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="B" FontWeight="Bold" Padding="12,4" Click="NotesBold_Click" ToolTip="Bold"/>
                    <Button Content="I" FontStyle="Italic" Padding="12,4" Margin="4,0,0,0" Click="NotesItalic_Click" ToolTip="Italic"/>
                    <Button Content="H" Padding="12,4" Margin="4,0,0,0" Click="NotesHeading_Click" ToolTip="Heading"/>
                    <Button Content="•—" Padding="12,4" Margin="4,0,0,0" Click="NotesBullet_Click" ToolTip="Bullet list"/>
                    <Button Content="☑" Padding="12,4" Margin="4,0,0,0" Click="NotesChecklist_Click" ToolTip="Checklist"/>
                    <ComboBox x:Name="NotesFontSizeCombo" Width="56" Margin="8,0,0,0" SelectionChanged="NotesFontSizeCombo_SelectionChanged" ToolTip="Font size"/>
                    <StackPanel Margin="2,0,0,0" VerticalAlignment="Stretch">
                        <Button Content="▲" FontSize="8" Padding="4,1" Height="15" Click="NotesFontSizeUp_Click"/>
                        <Button Content="▼" FontSize="8" Padding="4,1" Height="15" Margin="0,1,0,0" Click="NotesFontSizeDown_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="NotesFontFamilyCombo" Width="150" Margin="8,0,0,0" SelectionChanged="NotesFontFamilyCombo_SelectionChanged" ToolTip="Font"/>
                </StackPanel>
                <RichTextBox x:Name="NotesRichBox" Height="440"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="12" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="NotesRichBox_PreviewMouseLeftButtonDown"/>
            </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
