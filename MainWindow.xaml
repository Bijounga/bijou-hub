<Window x:Class="BijouHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BijouHub"
        mc:Ignorable="d"
        Title="BijouHub" Height="820" Width="1280" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app-icon.ico"
        Background="{DynamicResource WallpaperBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="AppScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid Margin="{DynamicResource ShellPadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar panel. Calm themes: flush with a hairline edge. Fx themes: floats on the
             wallpaper. The surface (which carries the panel's shadow) and the content are
             siblings, not parent/child, so the content keeps ClearType; texture, bevel and
             screws are optional layers in between. -->
        <Grid Grid.Column="0" Margin="{DynamicResource SidebarMargin}">
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarEdgeBrush}"
                    BorderThickness="{DynamicResource SidebarBorderThickness}" CornerRadius="{DynamicResource PanelRadius}"
                    Effect="{DynamicResource PanelShadow}"/>
            <Border Background="{DynamicResource PanelTextureBrush}" CornerRadius="{DynamicResource PanelRadius}" IsHitTestVisible="False"/>
            <Grid Visibility="{DynamicResource PanelBevelVisibility}" IsHitTestVisible="False">
                <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource PanelBevelOuterLightBrush}"/>
                <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource PanelBevelOuterDarkBrush}"/>
                <Border BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource PanelBevelInnerLightBrush}"/>
                <Border BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource PanelBevelInnerDarkBrush}"/>
            </Grid>
            <Grid Visibility="{DynamicResource ScrewsVisibility}" IsHitTestVisible="False">
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"/>
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"/>
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
            </Grid>
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <!-- Classic-chrome only: ClassicChromeVisibility comes from the active control-template set. -->
                <Ellipse x:Name="AmbientGlow" Width="220" Height="220" Fill="{DynamicResource AccentGradientBrush}" Opacity="0.10"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-110,0,0"
                         Visibility="{DynamicResource ClassicChromeVisibility}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="60"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>
            <Grid Margin="{DynamicResource PanelInset}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title strip: a glass bar, a Win95 caption, a perforated metal plate... or nothing. -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarHeaderBrush}" CornerRadius="{DynamicResource PanelTopRadius}"
                        BorderBrush="{DynamicResource SidebarHeaderEdgeBrush}" BorderThickness="{DynamicResource SidebarHeaderBorderThickness}">
                    <Grid>
                        <Border Background="{DynamicResource SidebarHeaderTextureBrush}" CornerRadius="{DynamicResource PanelTopRadius}" IsHitTestVisible="False"/>
                        <Grid Margin="{DynamicResource SidebarHeaderPadding}" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="HomeHeader_Click">
                            <StackPanel Orientation="Horizontal" Margin="{DynamicResource LogoMargin}">
                                <Polygon Points="6,0 18,0 24,8 18,16 6,16 0,8"
                                         Fill="{StaticResource GemGradientBrush}"
                                         Stroke="#071018" StrokeThickness="1.2" StrokeLineJoin="Round"
                                         Width="24" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Visibility="{DynamicResource LogoStandardVisibility}"/>
                                <Grid VerticalAlignment="Center" Visibility="{DynamicResource LogoStandardVisibility}">
                                    <!-- Vaporwave's chromatic split: cyan and pink ghosts either side of the title. -->
                                    <TextBlock Text="BijouHub" Style="{StaticResource HeadingText}" FontSize="{DynamicResource LogoFontSize}"
                                               Foreground="#B300E6FF" Margin="1.5,0,-1.5,0" Visibility="{DynamicResource TitleGlitchVisibility}"/>
                                    <TextBlock Text="BijouHub" Style="{StaticResource HeadingText}" FontSize="{DynamicResource LogoFontSize}"
                                               Foreground="#B3FF3CC8" Margin="-1.5,0,1.5,0" Visibility="{DynamicResource TitleGlitchVisibility}"/>
                                    <TextBlock Text="BijouHub" Style="{StaticResource HeadingText}" FontSize="{DynamicResource LogoFontSize}"
                                               Foreground="{DynamicResource SidebarHeaderInkBrush}"/>
                                </Grid>
                                <!-- Doodle Club: Bijou Doodle's star and felt-tip wordmark. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{DynamicResource LogoDoodleVisibility}">
                                    <TextBlock Text="&#x2605;" Foreground="#F4B400" FontSize="19" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B" Foreground="#1F5FBF" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"/>
                                        <TextBlock Text="i" Foreground="#B92A65" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-7"/></TextBlock.RenderTransform></TextBlock>
                                        <TextBlock Text="j" Foreground="#258026" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><TranslateTransform Y="-2"/></TextBlock.RenderTransform></TextBlock>
                                        <TextBlock Text="o" Foreground="#AA5100" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="6"/></TextBlock.RenderTransform></TextBlock>
                                        <TextBlock Text="u" Foreground="#813CAA" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"/>
                                        <TextBlock Text="H" Foreground="#1F5FBF" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"/>
                                        <TextBlock Text="u" Foreground="#B92A65" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-7"/></TextBlock.RenderTransform></TextBlock>
                                        <TextBlock Text="b" Foreground="#258026" FontFamily="Comic Sans MS" FontWeight="Black" FontSize="20" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><TranslateTransform Y="-2"/></TextBlock.RenderTransform></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="VersionText" FontSize="10" Margin="8,0,0,2" VerticalAlignment="Bottom" Opacity="0.6"
                                           Foreground="{DynamicResource SidebarHeaderInkBrush}" ToolTip="BijouHub version"/>
                            </StackPanel>
                            <Grid x:Name="HeaderBrackets" Visibility="{DynamicResource ClassicChromeVisibility}">
                                <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Line X1="0" Y1="0" X2="0" Y2="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                <Line X1="0" Y1="0" X2="0" Y2="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="{DynamicResource SidebarBodyMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource GhostIconButton}" Padding="6,4" Click="NewMode_Click"
                            ToolTip="New mode" AutomationProperties.Name="New mode">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="12"/>
                    </Button>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="MODES"/></TextBlock>
                </DockPanel>

                <ListBox x:Name="ModesList" Grid.Row="1"
                         AlternationCount="3"
                         SelectionChanged="ModesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToBrushConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="2" Margin="4,16,0,6">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource GhostIconButton}" Padding="6,4" Click="NewProject_Click"
                            ToolTip="New project" AutomationProperties.Name="New project">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="12"/>
                    </Button>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="PROJECTS"/></TextBlock>
                </DockPanel>

                <ListBox x:Name="ProjectsList" Grid.Row="3"
                         AlternationCount="3"
                         SelectionChanged="ProjectsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToBrushConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Everything that isn't daily work lives in one quiet row of tools. -->
                <UniformGrid Grid.Row="4" Rows="1" Margin="0,12,0,0">
                    <Button Style="{DynamicResource GhostIconButton}" Click="SessionLog_Click" ToolTip="Session log"
                            AutomationProperties.Name="Session Log">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE81C;" FontSize="16"/>
                    </Button>
                    <Button x:Name="SyncFolderButton" Style="{DynamicResource GhostIconButton}" Click="SyncFolder_Click" ToolTip="Sync folder"
                            AutomationProperties.Name="Sync Folder">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8F7;" FontSize="16"/>
                    </Button>
                    <Button x:Name="StartupToggleButton" Style="{DynamicResource GhostIconButton}" Click="StartupToggle_Click" ToolTip="Start with Windows"
                            AutomationProperties.Name="Start with Windows">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7E8;" FontSize="16"/>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{DynamicResource GhostIconButton}" Click="OpenTheme_Click" ToolTip="Theme"
                            AutomationProperties.Name="Theme">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE790;" FontSize="16"/>
                    </Button>
                    <Button x:Name="StreamDeckButton" Style="{DynamicResource GhostIconButton}" Click="OpenStreamDeck_Click" ToolTip="Stream Deck"
                            AutomationProperties.Name="Stream Deck">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A9;" FontSize="16"/>
                    </Button>
                    <Button x:Name="KeepRunningButton" Style="{DynamicResource GhostIconButton}" Click="KeepRunning_Click"
                            AutomationProperties.Name="Keep running in the background">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Quit BijouHub" Click="Quit_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE718;" FontSize="16"/>
                    </Button>
                </UniformGrid>
                <Button x:Name="UpdateButton" Grid.Row="5" Style="{DynamicResource AccentButton}" Margin="0,10,0,0" Padding="10,8"
                        Click="UpdateButton_Click" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Content panel: same layering as the sidebar. -->
        <Grid Grid.Column="1">
            <Border Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource ContentEdgeBrush}"
                    BorderThickness="{DynamicResource ContentBorderThickness}" CornerRadius="{DynamicResource PanelRadius}"
                    Effect="{DynamicResource PanelShadow}"/>
            <Border Background="{DynamicResource PanelTextureBrush}" CornerRadius="{DynamicResource PanelRadius}" IsHitTestVisible="False"/>
            <Grid Visibility="{DynamicResource PanelBevelVisibility}" IsHitTestVisible="False">
                <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource PanelBevelOuterLightBrush}"/>
                <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource PanelBevelOuterDarkBrush}"/>
                <Border BorderThickness="1,1,0,0" Margin="1" BorderBrush="{DynamicResource PanelBevelInnerLightBrush}"/>
                <Border BorderThickness="0,0,1,1" Margin="1" BorderBrush="{DynamicResource PanelBevelInnerDarkBrush}"/>
            </Grid>
            <Grid Visibility="{DynamicResource ScrewsVisibility}" IsHitTestVisible="False">
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"/>
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"/>
                <Image Source="{DynamicResource ScrewImage}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
            </Grid>
            <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
            <Grid Margin="{DynamicResource ContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="ActiveSessionBanner" Visibility="Collapsed" Background="{DynamicResource CardBrush}" Effect="{DynamicResource GlowBanner}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="12,7"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                    MouseLeftButtonDown="ActiveSessionBanner_Click" Panel.ZIndex="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="ActiveSessionBannerText" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text="  ·  click to return" Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="11,0 33,0 44,15 33,30 11,30 0,15"
                         Fill="{StaticResource GemGradientBrush}"
                         Stroke="#071018" StrokeThickness="1.5" StrokeLineJoin="Round"
                         Width="44" Height="30" Opacity="0.45" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Select a mode, or create one to get started."
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Mode detail (idle, not launched) -->
            <StackPanel x:Name="ModeDetailPanel" Visibility="Collapsed">
                <TextBlock x:Name="ModeDetailName" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,20"/>

                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="LAUNCH ITEMS"/></TextBlock>
                <ItemsControl x:Name="ModeDetailLaunchItems" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="10,7" Margin="0,0,0,6">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="BLOCKED"/></TextBlock>
                <ItemsControl x:Name="ModeDetailBlockItems" Margin="0,0,0,28">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="10,7" Margin="0,0,0,6">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding ProcessName}"/>
                                    <TextBlock Text="HARD BLOCK" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Visibility="{Binding IsHardBlock, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Countdown timers saved on this mode: one click launches the mode and counts down. -->
                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="TIMERS"/></TextBlock>
                <WrapPanel x:Name="ModeTimerTiles"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox x:Name="ModeTimerBox" Width="120" VerticalContentAlignment="Center"
                             TextChanged="ModeTimerBox_TextChanged" KeyDown="ModeTimerBox_KeyDown"
                             ToolTip="How long: 45, 1:30, 2h. Right-click a saved timer to remove it."/>
                    <Button x:Name="ModeTimerStartButton" Margin="8,0,0,0" Padding="14,6" AutomationProperties.Name="Start"
                            Click="ModeTimerStart_Click" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Start" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ModeTimerSaveButton" Margin="8,0,0,0" Padding="14,6" AutomationProperties.Name="Save timer"
                            ToolTip="Save this length as a timer on the mode"
                            Click="ModeTimerSave_Click" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Save" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <TextBlock x:Name="ModeTimerHint" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{DynamicResource AccentButton}" Padding="20,9" Click="Launch_Click" AutomationProperties.Name="Launch"
                            ToolTip="Launch the mode and count up, with no time limit"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Launch" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Margin="8,0,0,0" Padding="11,9" Click="EditMode_Click" ToolTip="Edit mode" AutomationProperties.Name="Edit mode"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70F;" FontSize="14"/></Button>
                    <Button Margin="8,0,0,0" Padding="11,9" Click="DeleteMode_Click" ToolTip="Delete mode" AutomationProperties.Name="Delete mode"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" FontSize="14"/></Button>
                </StackPanel>
            </StackPanel>

            <!-- Active session -->
            <StackPanel x:Name="ActiveSessionPanel" Visibility="Collapsed">
                <TextBlock x:Name="ActiveModeName" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,4"/>
                <TextBlock x:Name="ActiveContextText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock x:Name="ActiveStatus" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,24"/>

                <!-- The timer's display: bare digits in calm themes, an LCD/CRT/terminal in others,
                     with an overlay (dot matrix, scanlines) and a glass reflection over the digits. -->
                <Grid HorizontalAlignment="Left" Margin="0,0,0,28">
                    <Border Background="{DynamicResource TimerScreenBrush}" BorderBrush="{DynamicResource TimerScreenEdgeBrush}"
                            BorderThickness="{DynamicResource TimerScreenBorderThickness}" CornerRadius="{DynamicResource TimerScreenRadius}"/>
                    <TextBlock x:Name="TimerDisplay" Style="{StaticResource HeadingText}" Text="00:00:00" FontSize="52"
                               FontFamily="{DynamicResource TimerFont}" FontWeight="{DynamicResource TimerFontWeight}"
                               Foreground="{DynamicResource TimerTextBrush}" Effect="{DynamicResource TimerGlow}"
                               Margin="{DynamicResource TimerScreenPadding}"/>
                    <Border Background="{DynamicResource TimerScreenOverlayBrush}" CornerRadius="{DynamicResource TimerScreenRadius}"
                            Margin="{DynamicResource TimerScreenBorderThickness}" IsHitTestVisible="False"/>
                    <Border Background="{DynamicResource TimerScreenGlassBrush}" CornerRadius="{DynamicResource TimerScreenRadius}"
                            Margin="{DynamicResource TimerScreenBorderThickness}" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel x:Name="BlockNotifications" Margin="0,0,0,28"/>

                <StackPanel Orientation="Horizontal">
                    <Button Padding="16,8" Click="FinishSession_Click" AutomationProperties.Name="Finish session" ToolTip="Finish and log this session"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Finish" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="PauseToggleButton" Margin="8,0,0,0" Padding="12,8" Click="PauseToggle_Click" ToolTip="Pause" AutomationProperties.Name="Pause"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE769;" FontSize="14"/></Button>
                    <Button x:Name="NotesToggleButton" Margin="8,0,0,0" Padding="12,8" Click="NotesToggle_Click" ToolTip="Notes" AutomationProperties.Name="Notes"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70B;" FontSize="14"/></Button>
                    <Button x:Name="PopoutToggleButton" Margin="8,0,0,0" Padding="12,8" Click="PopoutToggle_Click" ToolTip="Pop out the timer" AutomationProperties.Name="Pop out"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;" FontSize="14"/></Button>
                </StackPanel>
            </StackPanel>

            <!-- Project detail -->
            <ScrollViewer x:Name="ProjectDetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="380" HorizontalAlignment="Left">
                        <TextBlock x:Name="ProjectDetailName" Style="{StaticResource HeadingText}" FontSize="26" Margin="0,0,0,12"/>

                        <Border Width="320" Height="14" CornerRadius="7" Background="{DynamicResource CardBrush}"
                                HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Border x:Name="ProjectProgressFill" Width="0" Height="14" CornerRadius="7"
                                    Background="{DynamicResource ProgressFillBrush}" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock x:Name="ProjectProgressLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ProjectTimeSpentText" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,20"/>

                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="GOALS"/></TextBlock>
                        <ItemsControl x:Name="ProjectGoalsDisplay" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" Effect="{DynamicResource GlowGoalBar}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" Padding="10,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete, Mode=OneWay}"
                                                              Margin="0,0,8,0" Tag="{Binding}"
                                                              Visibility="{Binding SubGoals.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                                              Checked="GoalCheckBox_Changed" Unchecked="GoalCheckBox_Changed"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Completion, StringFormat={}{0:P0}}"
                                                               Foreground="{DynamicResource HazardBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Visibility="{Binding SubGoals.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=NonZero}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Weight, StringFormat={}{0}%}"
                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SubGoals}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{DynamicResource HazardBrush}" Margin="0,0,8,0"/>
                                                                <Grid Grid.Column="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete, Mode=OneWay}"
                                                                              Margin="0,0,8,0" Tag="{Binding}"
                                                                              Checked="GoalCheckBox_Changed" Unchecked="GoalCheckBox_Changed"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Weight, StringFormat={}{0}%}"
                                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Style="{DynamicResource AccentButton}" Padding="20,9" Click="StartProjectSession_Click" Margin="0,0,8,8" AutomationProperties.Name="Start session"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Start Session" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Padding="11,9" Click="LogTime_Click" Margin="0,0,8,8" ToolTip="Log time you worked away from BijouHub" AutomationProperties.Name="Log time"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE823;" FontSize="14"/></Button>
                            <Button Padding="11,9" Click="EditProject_Click" Margin="0,0,8,8" ToolTip="Edit project" AutomationProperties.Name="Edit project"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70F;" FontSize="14"/></Button>
                            <Button Padding="11,9" Click="DeleteProject_Click" Margin="0,0,8,8" ToolTip="Delete project" AutomationProperties.Name="Delete project"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" FontSize="14"/></Button>
                            <Button x:Name="ProjectNotesToggleButton" Padding="11,9" Click="NotesToggle_Click" Margin="0,0,8,8" ToolTip="Hide notes" AutomationProperties.Name="Notes"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70B;" FontSize="14"/></Button>
                        </WrapPanel>

                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="SESSION NOTES"/></TextBlock>
                        <ItemsControl x:Name="ProjectNotesDisplay">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
            </ScrollViewer>

            <!-- Home dashboard -->
            <ScrollViewer x:Name="HomePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="HomeWelcomeText" Style="{StaticResource HeadingText}" FontSize="28" Margin="0,0,0,4"/>
                    <TextBlock x:Name="HomeGreetingText" FontSize="16" Margin="0,0,0,24" TextWrapping="Wrap" Effect="{DynamicResource GlowGreeting}"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <!-- Today: the day's goals (type, Enter, repeat) beside a glance at time worked. -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="720"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                <!-- Today's goals, or tomorrow's plan. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="DayTodayTab" Click="DayToday_Click" Cursor="Hand" AutomationProperties.Name="Today" ToolTip="Today's goals">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                                        <TextBlock x:Name="DayTodayText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="TODAY"/></TextBlock>
                                    </Button>
                                    <Button x:Name="DayTomorrowTab" Click="DayTomorrow_Click" Cursor="Hand" Margin="14,0,0,0"
                                            AutomationProperties.Name="Tomorrow" ToolTip="Plan tomorrow">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="DayTomorrowText" Text="TOMORROW" FontSize="11" Foreground="{DynamicResource FaintTextBrush}"/>
                                            <TextBlock x:Name="DayTomorrowCount" FontSize="11" Margin="5,0,0,0" Foreground="{DynamicResource AccentBrush}"/>
                                            <Ellipse x:Name="PlanNudgeDot" Width="5" Height="5" Margin="5,0,0,1" VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="DailyProgressText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" VerticalAlignment="Bottom"/>
                                <Button x:Name="GoogleSyncButton" DockPanel.Dock="Right" Margin="0,0,14,0" Click="GoogleSync_Click"
                                        Cursor="Hand" VerticalAlignment="Bottom" AutomationProperties.Name="Google Tasks sync">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="GoogleSyncGlyph" Style="{StaticResource IconGlyph}" FontSize="13"/>
                                        <TextBlock x:Name="GoogleSyncText" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <!-- One tab per Google Tasks list group (EDITING, STUDY, LIFE…), plus All. -->
                            <WrapPanel x:Name="GoalScopeTabs" Margin="0,0,0,4" Visibility="Collapsed"/>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusBase}" Padding="14,12">
                                <StackPanel>
                                    <DockPanel x:Name="CarryOverRow" Margin="0,0,0,10" LastChildFill="False" Visibility="Collapsed">
                                        <Button x:Name="CarryOverButton" Padding="12,5" Click="CarryOver_Click"/>
                                        <Button Content="Dismiss" Margin="8,0,0,0" Padding="10,5" Click="DismissCarryOver_Click"/>
                                    </DockPanel>

                                    <ListBox x:Name="DailyGoalsList" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="2,3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Background="Transparent" ContextMenuOpening="DailyGoalRow_ContextMenuOpening">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu/>
                                                    </Grid.ContextMenu>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="⠿" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Done, Mode=TwoWay}" VerticalAlignment="Center"
                                                              Margin="2,0,6,0" AutomationProperties.Name="{Binding Text}"/>
                                                    <Button Grid.Column="2" Click="DailyGoalStar_Click" Cursor="Hand" VerticalAlignment="Center"
                                                            Focusable="False" Margin="0,0,8,0" ToolTip="Star to pin it to the top"
                                                            AutomationProperties.Name="Star">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="2,0">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock FontSize="15">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="☆"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Starred}" Value="True">
                                                                            <Setter Property="Text" Value="★"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource HazardBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                                   MouseLeftButtonDown="DailyGoalText_MouseLeftButtonDown" ToolTip="Double-click to edit">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" Padding="4,2" Margin="-5,-3,0,-3"
                                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                 IsVisibleChanged="DailyGoalEditor_IsVisibleChanged"
                                                                 KeyDown="DailyGoalEditor_KeyDown" LostKeyboardFocus="DailyGoalEditor_LostKeyboardFocus"/>
                                                    </Grid>
                                                    <Border Grid.Column="4" CornerRadius="9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Cursor="Hand" MouseLeftButtonUp="DailyGoalChip_Click" ToolTip="Change the linked project"
                                                            Visibility="{Binding ChipText, Converter={StaticResource EmptyToCollapsedConverter}}">
                                                        <TextBlock Text="{Binding ChipText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="5" Click="DailyGoalDelete_Click" Focusable="False" Cursor="Hand"
                                                            Margin="6,0,2,0" VerticalAlignment="Center" ToolTip="Delete" AutomationProperties.Name="Delete goal">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="5,1">
                                                                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource FaintTextBrush}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <!-- "Add a task" bar, Microsoft To Do style: type, Enter, repeat. -->
                                    <Border x:Name="AddGoalBar" CornerRadius="6" BorderThickness="1" Padding="12,0" MinHeight="44"
                                            Cursor="IBeam" MouseLeftButtonDown="AddGoalBar_MouseLeftButtonDown"
                                            IsKeyboardFocusWithinChanged="AddGoalBar_IsKeyboardFocusWithinChanged">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- "+" at rest; an empty circle while typing, like To Do. -->
                                            <TextBlock x:Name="AddGoalGlyph" Text="+" FontSize="22" Width="22" Margin="0,0,10,2"
                                                       VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBox x:Name="DailyGoalInput" FontSize="14" Background="Transparent" BorderThickness="0" Padding="0"
                                                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                         KeyDown="DailyGoalInput_KeyDown" TextChanged="DailyGoalInput_TextChanged"
                                                         AutomationProperties.Name="Add a task">
                                                    <TextBox.Template>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                                        </ControlTemplate>
                                                    </TextBox.Template>
                                                </TextBox>
                                                <TextBlock x:Name="DailyGoalPlaceholder" Text="Add a task" FontSize="14" Margin="2,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ComboBox x:Name="DailyGoalProjectCombo" Grid.Column="2" Width="150" Margin="10,6,0,6"
                                                      Visibility="Collapsed" SelectionChanged="DailyGoalProjectCombo_SelectionChanged"
                                                      ToolTip="Link new tasks to a project (optional)"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="DailyNotesLabel" Text="NOTES FOR TODAY" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,14,0,4"/>
                                    <TextBox x:Name="DailyNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="220"
                                             VerticalScrollBarVisibility="Auto" Padding="8,6" TextChanged="DailyNotesBox_TextChanged"
                                             LostKeyboardFocus="DailyNotesBox_LostKeyboardFocus" AutomationProperties.Name="Notes for today"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="TODAY"/></TextBlock>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusBase}" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeTodayText" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="HomeTargetText" Text="worked today" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <!-- Fills toward the daily target; click to set it. -->
                                        <Button x:Name="DailyTargetButton" Grid.Column="1" Click="DailyTarget_Click" Cursor="Hand" VerticalAlignment="Center"
                                                AutomationProperties.Name="Daily target" ToolTip="Set a daily target">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                                            <Grid Width="54" Height="54">
                                                <Ellipse Stroke="{DynamicResource SoftBorderBrush}" StrokeThickness="5"/>
                                                <Path x:Name="DailyTargetArc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{DynamicResource AccentBrush}"/>
                                                <TextBlock x:Name="DailyTargetLabel" Text="+" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <ItemsControl x:Name="HomeWeekBars">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock x:Name="HomeWeekText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Project board (formerly the separate BijouBoard app). -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="PROJECTS"/></TextBlock>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource GhostIconButton}" HorizontalAlignment="Right" Padding="7,5" Click="RefreshBoard_Click"
                                ToolTip="Refresh — script progress comes from BijouDocs and tracks from BijouMusic, matched by project name"
                                AutomationProperties.Name="Refresh projects"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="13"/></Button>
                    </DockPanel>
                    <WrapPanel x:Name="BoardSummary" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="BoardCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="340" Margin="0,0,14,14" Padding="16,14" BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusBase}" Cursor="Hand" MouseLeftButtonUp="BoardCard_Click"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                            <Border CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=Soft}">
                                                <TextBlock Text="{Binding StatusPillText}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="SCRIPT" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,0,7"/>
                                            <DockPanel Grid.Column="1" Margin="0,0,0,7">
                                                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Fill="{Binding ScriptTone, Converter={StaticResource ToneBrushConverter}}"/>
                                                <TextBlock Text="{Binding ScriptLabel}" FontSize="13"/>
                                                <TextBlock Text="{Binding ScriptDetail, StringFormat=' — {0}'}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                                           ToolTip="{Binding ScriptDetail}"/>
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="MUSIC" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,0,7"/>
                                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,7">
                                                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Fill="{Binding MusicTone, Converter={StaticResource ToneBrushConverter}}"/>
                                                <TextBlock Text="{Binding MusicLabel}" FontSize="13"/>
                                                <TextBlock Text="{Binding MusicDetail, StringFormat=' — {0}'}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                                           ToolTip="{Binding MusicDetail}"/>
                                            </DockPanel>
                                            <TextBlock Grid.Row="2" Text="TIME" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimeThisWeek}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text=" this week" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding GoalsText}" FontSize="12" Margin="0,14,0,6"/>
                                        <Grid Height="6">
                                            <Border CornerRadius="3" Background="{DynamicResource SoftBorderBrush}"/>
                                            <Border CornerRadius="3" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding GoalsFraction}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding NextGoal}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding NextGoal, Converter={StaticResource EmptyToCollapsedConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BoardEmptyText" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               Text="No projects yet — add one with the + next to Projects."/>
                    <Border Height="14"/>

                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,8"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="QUICK LAUNCH"/></TextBlock>
                    <WrapPanel x:Name="QuickLaunchPanel" Margin="0,0,0,24"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- Shared notes panel: toggleable, shown alongside Project Detail or Active Session -->
            <StackPanel x:Name="NotesPanel" Grid.Column="1" Width="420" Margin="24,0,0,0" Visibility="Collapsed">
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="MY NOTES"/></TextBlock>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource GhostIconButton}" HorizontalAlignment="Right" Padding="7,4" Click="OpenKeybinds_Click"
                            ToolTip="Keyboard shortcuts" AutomationProperties.Name="Keyboard shortcuts"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE765;" FontSize="14"/></Button>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Padding="9,6" Click="NotesBold_Click" ToolTip="Bold" AutomationProperties.Name="Bold"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8DD;" FontSize="12"/></Button>
                    <Button Padding="9,6" Margin="4,0,0,0" Click="NotesItalic_Click" ToolTip="Italic" AutomationProperties.Name="Italic"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8DB;" FontSize="12"/></Button>
                    <Button Padding="9,6" Margin="4,0,0,0" Click="NotesHeading_Click" ToolTip="Heading" AutomationProperties.Name="Heading"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8E9;" FontSize="12"/></Button>
                    <Button Padding="9,6" Margin="4,0,0,0" Click="NotesBullet_Click" ToolTip="Bullet list" AutomationProperties.Name="Bullet list"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8FD;" FontSize="12"/></Button>
                    <Button Padding="9,6" Margin="4,0,0,0" Click="NotesChecklist_Click" ToolTip="Checklist" AutomationProperties.Name="Checklist"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9D5;" FontSize="12"/></Button>
                    <ComboBox x:Name="NotesFontSizeCombo" Width="56" Margin="8,0,0,0" SelectionChanged="NotesFontSizeCombo_SelectionChanged" ToolTip="Font size"/>
                    <StackPanel Margin="2,0,0,0" VerticalAlignment="Stretch">
                        <Button Content="▲" FontSize="8" Padding="4,1" Height="15" Click="NotesFontSizeUp_Click"/>
                        <Button Content="▼" FontSize="8" Padding="4,1" Height="15" Margin="0,1,0,0" Click="NotesFontSizeDown_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="NotesFontFamilyCombo" Width="150" Margin="8,0,0,0" SelectionChanged="NotesFontFamilyCombo_SelectionChanged" ToolTip="Font"/>
                </StackPanel>
                <RichTextBox x:Name="NotesRichBox" Height="440"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="12" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="NotesRichBox_PreviewMouseLeftButtonDown"/>
            </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
