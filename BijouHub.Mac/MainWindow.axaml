<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BijouHub.Mac.Controls"
        xmlns:models="clr-namespace:BijouHub.Models;assembly=BijouHub.Core"
        x:Class="BijouHub.Mac.MainWindow"
        Title="BijouHub" Width="1240" Height="800" MinWidth="900" MinHeight="580">

    <Window.Styles>
        <!-- Goal rows: delete appears on hover; done goals strike through; starred stars glow. -->
        <Style Selector="ListBox.goalrows ListBoxItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBox.goalrows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.goalrows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem.channelhdr">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,8,0,1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem.channelhdr:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav ListBoxItem.channelhdr:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.navrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.navrow.on">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Button.navrow.on TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.taskcard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.taskcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        </Style>
        <Style Selector="Border.taskadd">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="TextBox#TasksInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox#TasksInput:focus /template/ Border#PART_BorderElement, TextBox#TasksInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="FlyoutPresenter.bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.rowdue">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.rowdue">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.duechip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style Selector="Border.duechip.overdue TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="Button.rowdelete">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.rowdelete">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style Selector="Button.star">
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
        </Style>
        <Style Selector="Button.star.starred">
            <Setter Property="Foreground" Value="{DynamicResource HazardBrush}"/>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- The To Do-style add bar. -->
        <Style Selector="Border#AddGoalBar">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border#AddGoalBar:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Border#AddGoalBar:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBox#DailyGoalInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox#DailyGoalInput:focus /template/ Border#PART_BorderElement, TextBox#DailyGoalInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Hover lift on board cards. -->
        <Style Selector="Border.boardcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
<DataTemplate x:Key="GoalRow">
                                                        <Grid ColumnDefinitions="18,Auto,Auto,*,Auto,Auto,Auto">
                                                            <Grid.ContextMenu>
                                                                <ContextMenu Opening="GoalMenu_Opening"/>
                                                            </Grid.ContextMenu>
                                                            <controls:LineIcon Kind="grip" Width="14" Height="14" StrokeWidth="2.2" Cursor="SizeAll"
                                                                               Foreground="{DynamicResource FaintTextBrush}" PointerPressed="GoalGrip_PointerPressed"
                                                                               ToolTip.Tip="Drag to reorder"/>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding Done}" MinWidth="0" Margin="2,0,4,0" AutomationProperties.Name="{Binding Text}"/>
                                                            <Button Grid.Column="2" Classes="ghost star" Classes.starred="{Binding Starred}" Padding="3"
                                                                    Margin="0,0,8,0" Click="GoalStar_Click" ToolTip.Tip="Star to pin it to the top">
                                                                <controls:LineIcon Kind="star" Width="15" Height="15" Filled="{Binding Starred}"/>
                                                            </Button>
                                                            <Panel Grid.Column="3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Text}" Classes.done="{Binding Done}" FontSize="14" TextWrapping="Wrap"
                                                                           IsVisible="{Binding !IsEditing}" DoubleTapped="GoalText_DoubleTapped"/>
                                                                <TextBox Text="{Binding Text, Mode=OneWay}" IsVisible="{Binding IsEditing}" Padding="4,2" MinHeight="0"
                                                                         KeyDown="GoalEditor_KeyDown" LostFocus="GoalEditor_LostFocus"
                                                                         PropertyChanged="GoalEditor_PropertyChanged"/>
                                                            </Panel>
                                                            <!-- When it's due: a chip once dated (red when past), or a calendar on hover. -->
                                                            <Panel Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <Border Classes="chip duechip" Classes.overdue="{Binding DueOverdue}" Cursor="Hand"
                                                                        PointerPressed="GoalDueChip_PointerPressed" ToolTip.Tip="Change the date and time"
                                                                        IsVisible="{Binding DueChip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <controls:LineIcon Kind="calendar" Width="10" Height="10"/>
                                                                        <TextBlock Text="{Binding DueChip}" FontSize="11"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Button Classes="ghost rowdue" Padding="4" Click="GoalDue_Click" ToolTip.Tip="Add a date and time"
                                                                        IsVisible="{Binding DueChip, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                    <controls:LineIcon Kind="calendar" Width="13" Height="13"/>
                                                                </Button>
                                                            </Panel>
                                                            <Button Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" Padding="0" Background="Transparent" BorderThickness="0"
                                                                    Click="GoalProjectChip_Click" ToolTip.Tip="Change the project"
                                                                    AutomationProperties.Name="{Binding ProjectChip, StringFormat='Project: {0}'}">
                                                            <Border Classes="chip">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                             Fill="{Binding ChannelColor, Converter={x:Static controls:HexBrushConverter.Instance}}"
                                                                             IsVisible="{Binding ChannelColor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                    <TextBlock Text="{Binding ProjectChip}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            </Button>
                                                            <Button Grid.Column="6" Classes="ghost rowdelete" Padding="5" Margin="6,0,0,0" Click="GoalDelete_Click" ToolTip.Tip="Delete">
                                                                <controls:LineIcon Kind="close" Width="11" Height="11"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
    </Window.Resources>

    <Grid Margin="{DynamicResource ShellPadding}" ColumnDefinitions="236,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Margin="{DynamicResource PanelGap}" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource PanelEdgeBrush}" BorderThickness="{DynamicResource PanelEdge}"
                CornerRadius="{DynamicResource PanelRadius}" BoxShadow="{DynamicResource PanelShadow}">
            <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto,Auto" Margin="14,16,14,12">
                <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,14" Cursor="Hand" Background="Transparent" PointerPressed="Logo_PointerPressed">
                    <Polygon Points="6,0 18,0 24,8 18,16 6,16 0,8" Width="24" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                             Stroke="#071018" StrokeThickness="1.2">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#EAF6FF" Offset="0.5"/>
                                <GradientStop Color="#A8D8F0" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <TextBlock Text="BijouHub" Classes="h2" VerticalAlignment="Center"/>
                    <!-- The version; click it to check for an update now. -->
                    <Button Name="VersionButton" Classes="ghost" Padding="2,0" Margin="6,0,0,0" VerticalAlignment="Bottom" Click="VersionButton_Click"
                            ToolTip.Tip="Click to check for updates" AutomationProperties.Name="Check for updates">
                        <TextBlock Name="VersionText" Classes="faint" FontSize="11"/>
                    </Button>
                </StackPanel>
                <!-- Home and the full task list. -->
                <Button Name="NavHomeButton" Classes="navrow" Click="NavHome_Click" AutomationProperties.Name="Home">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:LineIcon Kind="home" Width="15" Height="15" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Home" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Name="NavTasksButton" Classes="navrow" Click="NavTasks_Click" AutomationProperties.Name="Tasks">
                    <DockPanel>
                        <TextBlock Name="NavTasksCount" DockPanel.Dock="Right" FontSize="11" Classes="muted" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:LineIcon Kind="tasks" Width="15" Height="15" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="Tasks" FontSize="13"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Name="NavCalendarButton" Classes="navrow" Click="NavCalendar_Click" AutomationProperties.Name="Calendar" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:LineIcon Kind="calendar" Width="15" Height="15" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Calendar" FontSize="13"/>
                    </StackPanel>
                </Button>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="4,0,0,6">
                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="5" Click="NewMode_Click" ToolTip.Tip="New mode">
                        <controls:LineIcon Kind="add" Width="12" Height="12"/>
                    </Button>
                    <TextBlock Name="ModesLabel" Classes="label" Text="MODES" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox Name="ModesList" Grid.Row="2" Classes="nav" SelectionChanged="ModesList_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu Opening="SidebarMenu_Opening">
                            <MenuItem Header="Edit…" Click="EditMode_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete…" Click="DeleteMode_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3">
                <DockPanel Margin="4,14,0,6">
                    <Button DockPanel.Dock="Right" Classes="ghost" Padding="5" Click="NewProject_Click" ToolTip.Tip="New project">
                        <controls:LineIcon Kind="add" Width="12" Height="12"/>
                    </Button>
                    <TextBlock Name="ProjectsLabel" Classes="label" Text="PROJECTS" VerticalAlignment="Center"/>
                </DockPanel>
                <!-- Shown when projects belong to channels this computer doesn't have the names of. -->
                <Button Name="ChannelsNotice" IsVisible="False" Classes="ghost" Click="ChannelsNotice_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="8,6" Margin="0,0,0,6" AutomationProperties.Name="Restore channels">
                    <TextBlock Text="Channel names missing here. Click to restore them." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HazardBrush}"/>
                </Button>
                </StackPanel>
                <ListBox Name="ProjectsList" Grid.Row="4" Classes="nav" SelectionChanged="ProjectsList_SelectionChanged" ContainerPrepared="ProjectsList_ContainerPrepared">
                    <ListBox.ContextMenu>
                        <ContextMenu Opening="ProjectsMenu_Opening"/>
                    </ListBox.ContextMenu>
                    <ListBox.DataTemplates>
                        <!-- A channel's section title: click it to fold the section. -->
                        <DataTemplate DataType="models:ChannelHeader">
                            <Button Classes="ghost" Padding="2,3" Click="ChannelHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="Click to fold or unfold" AutomationProperties.Name="{Binding Name}">
                                <DockPanel>
                                    <Panel DockPanel.Dock="Left" Width="14" VerticalAlignment="Center">
                                        <TextBlock Text="▾" FontSize="10" Classes="muted" IsVisible="{Binding !Collapsed}"/>
                                        <TextBlock Text="▸" FontSize="10" Classes="muted" IsVisible="{Binding Collapsed}"/>
                                    </Panel>
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={x:Static controls:HexBrushConverter.Instance}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="models:Project">
                            <Grid ColumnDefinitions="4,*">
                                <Border Width="4" CornerRadius="2" Margin="0,1,10,1" IsVisible="{Binding HasChannel}"
                                        Background="{Binding ChannelColor, Converter={x:Static controls:HexBrushConverter.Instance}}"/>
                                <DockPanel Grid.Column="1">
                                    <!-- ★ marks the channel's main project. -->
                                    <TextBlock DockPanel.Dock="Right" Text="★" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource HazardBrush}" IsVisible="{Binding IsMain}" ToolTip.Tip="Main project"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

                <!-- Everything that isn't daily work: one quiet row of tools. -->
                <UniformGrid Grid.Row="5" Rows="1" Margin="0,12,0,0">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="SessionLog_Click" ToolTip.Tip="Session log">
                        <controls:LineIcon Kind="history" Width="17" Height="17"/>
                    </Button>
                    <Button Name="SyncFolderButton" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="SyncFolder_Click" ToolTip.Tip="Sync folder">
                        <controls:LineIcon Kind="folder" Width="17" Height="17"/>
                    </Button>
                    <Button Name="LoginItemButton" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="LoginItem_Click" ToolTip.Tip="Open at login">
                        <controls:LineIcon Kind="power" Width="17" Height="17"/>
                    </Button>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Theme_Click" ToolTip.Tip="Theme">
                        <controls:LineIcon Kind="palette" Width="17" Height="17"/>
                    </Button>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="StreamDeck_Click" ToolTip.Tip="Stream Deck">
                        <controls:LineIcon Kind="deck" Width="17" Height="17"/>
                    </Button>
                    <Button Name="KeepRunningButton" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="KeepRunning_Click" AutomationProperties.Name="Keep running in the background">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Quit BijouHub" Click="Quit_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <controls:LineIcon Kind="pin" Width="17" Height="17"/>
                    </Button>
                </UniformGrid>
                <Button Name="UpdateButton" Grid.Row="6" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,10,0,0" IsVisible="False" Click="UpdateButton_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource PanelEdgeBrush}"
                BorderThickness="{DynamicResource PanelEdge}" CornerRadius="{DynamicResource PanelRadius}"
                BoxShadow="{DynamicResource PanelShadow}" ClipToBounds="True">
            <Grid ColumnDefinitions="*,Auto">
                <Panel Grid.Column="0">

                    <!-- Home -->
                    <ScrollViewer Name="HomePanel" Padding="28,26,28,20">
                        <StackPanel>
                            <TextBlock Name="HomeDateText" Classes="h1"/>
                            <TextBlock Name="HomeGreetingText" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,24" TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="*,20,260" Margin="0,0,0,28">
                                <StackPanel Grid.Column="0" MaxWidth="720">
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <!-- Today's goals, or tomorrow's plan. -->
                                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                                            <Button Name="DayTodayTab" Classes="ghost" Padding="0" Background="Transparent" Click="DayToday_Click" ToolTip.Tip="Today's goals"
                                                    AutomationProperties.Name="Today">
                                                <TextBlock Name="DayTodayText" Classes="label" Text="TODAY" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Name="DayTomorrowTab" Classes="ghost" Padding="0" Background="Transparent" Click="DayTomorrow_Click" ToolTip.Tip="Plan tomorrow"
                                                    AutomationProperties.Name="Tomorrow">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Name="DayTomorrowText" Classes="label" Text="TOMORROW" Foreground="{DynamicResource FaintTextBrush}"/>
                                                    <TextBlock Name="DayTomorrowCount" Classes="label" Foreground="{DynamicResource AccentBrush}"/>
                                                    <Ellipse Name="PlanNudgeDot" Width="5" Height="5" VerticalAlignment="Center"
                                                             Fill="{DynamicResource AccentBrush}" IsVisible="False"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Name="DayUpcomingTab" Classes="ghost" Padding="0" Background="Transparent" Click="DayUpcoming_Click"
                                                    ToolTip.Tip="Everything dated after tomorrow" AutomationProperties.Name="Upcoming">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Name="DayUpcomingText" Classes="label" Text="UPCOMING" Foreground="{DynamicResource FaintTextBrush}"/>
                                                    <TextBlock Name="DayUpcomingCount" Classes="label" Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Name="DailyProgressText" DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Bottom"/>
                                        <Button DockPanel.Dock="Right" Classes="ghost" Padding="5,2" Margin="0,0,8,-3" VerticalAlignment="Bottom"
                                                Click="NavTasks_Click" ToolTip.Tip="Open every list, full size" AutomationProperties.Name="Open all tasks">
                                            <controls:LineIcon Kind="expand" Width="13" Height="13"/>
                                        </Button>
                                        <Button Name="GoogleSyncButton" DockPanel.Dock="Right" Classes="ghost" Padding="6,2" Margin="0,0,10,-3"
                                                VerticalAlignment="Bottom" Click="GoogleSync_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:LineIcon Name="GoogleSyncIcon" Kind="cloud" Width="14" Height="14"/>
                                                <TextBlock Name="GoogleSyncText" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                    <WrapPanel Name="GoalScopeTabs" Margin="0,0,0,6" IsVisible="False"/>
                                    <Border Classes="card" Padding="14,12">
                                        <StackPanel>
                                            <DockPanel Name="CarryOverRow" Margin="0,0,0,10" IsVisible="False" LastChildFill="False">
                                                <Button Name="CarryOverButton" Click="CarryOver_Click"/>
                                                <Button Content="Dismiss" Margin="8,0,0,0" Click="DismissCarryOver_Click"/>
                                            </DockPanel>
                                            <ListBox Name="DailyGoalsList" Background="Transparent" Margin="0,0,0,6" SelectionMode="Single"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" DragDrop.AllowDrop="True" Classes="goalrows" ItemTemplate="{StaticResource GoalRow}"/>

                                            <Border Name="AddGoalBar" CornerRadius="6" BorderThickness="1" Padding="12,0" MinHeight="42" Cursor="IBeam"
                                                    PointerPressed="AddGoalBar_PointerPressed">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <controls:LineIcon Name="AddGoalIcon" Kind="add" Width="16" Height="16" Margin="0,0,10,0"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBox Name="DailyGoalInput" FontSize="14" KeyDown="DailyGoalInput_KeyDown" TextChanged="DailyGoalInput_TextChanged"
                                                                 GotFocus="AddGoal_FocusChanged" LostFocus="AddGoal_FocusChanged"/>
                                                        <TextBlock Name="DailyGoalPlaceholder" Text="Add a task" FontSize="14" IsHitTestVisible="False"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    </Panel>
                                                    <Button Name="AddGoalDueButton" Grid.Column="2" Classes="ghost" Padding="6,4" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" Click="AddGoalDue_Click" IsVisible="False"
                                                            AutomationProperties.Name="Date and time">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <controls:LineIcon Kind="calendar" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Name="AddGoalDueText" FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AccentBrush}" IsVisible="False"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <ComboBox Name="DailyGoalProjectCombo" Grid.Column="3" Width="160" Margin="10,6,0,6" IsVisible="False"
                                                              SelectionChanged="DailyGoalProjectCombo_SelectionChanged" DropDownClosed="DailyGoalProjectCombo_DropDownClosed"
                                                              ToolTip.Tip="Link new tasks to a project or list (optional)"/>
                                                </Grid>
                                            </Border>

                                            <!-- Finished tasks, tucked away under the list; click to show or hide them. -->
                                            <Button Name="DailyCompletedToggle" Classes="ghost" Padding="0" Margin="2,12,0,6" HorizontalAlignment="Left"
                                                    Click="DailyCompletedToggle_Click" IsVisible="False" AutomationProperties.Name="Completed">
                                                <TextBlock Name="DailyCompletedText" FontSize="12" Classes="muted"/>
                                            </Button>
                                            <ListBox Name="DailyDoneList" Classes="goalrows" Background="Transparent" Margin="0,0,0,6" SelectionMode="Single"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" IsVisible="False" ItemTemplate="{StaticResource GoalRow}"/>

                                            <TextBlock Name="DailyNotesLabel" Classes="label" Text="NOTES FOR TODAY" Margin="2,14,0,4"/>
                                            <TextBox Name="DailyNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="220"
                                                     TextChanged="DailyNotesBox_TextChanged" LostFocus="DailyNotesBox_LostFocus"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="label" Text="TODAY" Margin="0,0,0,8"/>
                                    <Border Classes="card" Padding="16,14">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Name="HomeTodayText" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Name="HomeTargetText" Classes="muted" Text="worked today"/>
                                                </StackPanel>
                                                <!-- Fills toward the daily target; click to set it. -->
                                                <Button Name="DailyTargetButton" Grid.Column="1" Classes="ghost" Padding="0" VerticalAlignment="Center"
                                                        Click="DailyTarget_Click" ToolTip.Tip="Set a daily target" AutomationProperties.Name="Daily target">
                                                    <Panel Width="54" Height="54">
                                                        <Ellipse Stroke="{DynamicResource SoftBorderBrush}" StrokeThickness="5"/>
                                                        <Path Name="DailyTargetArc" StrokeThickness="5" StrokeLineCap="Round" Stroke="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Name="DailyTargetLabel" Text="+" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                            <UniformGrid Name="HomeWeekBars" Rows="1"/>
                                            <TextBlock Name="HomeWeekText" Classes="muted" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                <TextBlock Name="BoardLabel" Classes="label" Text="PROJECTS" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Classes="ghost" Padding="6" Click="RefreshBoard_Click"
                                        ToolTip.Tip="Refresh — script progress comes from BijouDocs and tracks from BijouMusic, matched by project name">
                                    <controls:LineIcon Kind="refresh" Width="14" Height="14"/>
                                </Button>
                            </DockPanel>
                            <WrapPanel Name="BoardChannelPills" Margin="0,0,0,2"/>
                            <WrapPanel Name="BoardSummary" Margin="0,0,0,12"/>
                            <ItemsControl Name="BoardCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Name="BoardEmptyText" Classes="muted" IsVisible="False" Text="No projects yet — add one with the + next to Projects."/>

                            <TextBlock Classes="label" Text="QUICK LAUNCH" Margin="0,24,0,8"/>
                            <WrapPanel Name="QuickLaunchPanel" Margin="0,0,0,12"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Mode -->
                    <ScrollViewer Name="ModePanel" Padding="28,26" IsVisible="False">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Name="ModeNameText" Classes="h1" Margin="0,0,0,20"/>
                            <TextBlock Classes="label" Text="OPENS" Margin="0,0,0,6"/>
                            <ItemsControl Name="ModeLaunchItems" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Padding="10,7" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Name="ModeNoItemsText" Classes="muted" Text="Nothing to open yet — add apps, folders or links with the edit button." Margin="0,-14,0,20"/>

                            <TextBlock Classes="label" Text="TIMERS" Margin="0,0,0,8"/>
                            <WrapPanel Name="ModeTimerTiles"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <TextBox Name="ModeTimerBox" Width="130" Watermark="45, 2h, 25/5" TextChanged="ModeTimerBox_TextChanged" KeyDown="ModeTimerBox_KeyDown"
                                         ToolTip.Tip="How long: 45, 1:30, 2h. Right-click a saved timer to remove it."/>
                                <Button Name="ModeTimerStartButton" IsEnabled="False" Click="ModeTimerStart_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:LineIcon Kind="play" Width="12" Height="12"/><TextBlock Text="Start"/></StackPanel>
                                </Button>
                                <Button Name="ModeTimerSaveButton" IsEnabled="False" Click="ModeTimerSave_Click" ToolTip.Tip="Save this length as a timer on the mode">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:LineIcon Kind="add" Width="12" Height="12"/><TextBlock Text="Save"/></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Name="ModeTimerHint" FontSize="12" IsVisible="False" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
                                <Button Classes="primary" Padding="18,8" Click="Launch_Click" ToolTip.Tip="Launch the mode and count up, with no time limit">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="play" Width="12" Height="12"/><TextBlock Text="Launch"/></StackPanel>
                                </Button>
                                <Button Classes="icon" Click="EditMode_Click" ToolTip.Tip="Edit mode"><controls:LineIcon Kind="edit"/></Button>
                                <Button Classes="icon" Click="DeleteMode_Click" ToolTip.Tip="Delete mode"><controls:LineIcon Kind="delete"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Project -->
                    <ScrollViewer Name="ProjectPanel" Padding="28,26" IsVisible="False">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Name="ProjectNameText" Classes="h1" Margin="0,0,0,12"/>
                            <ProgressBar Name="ProjectProgressBar" Minimum="0" Maximum="1" Width="260" HorizontalAlignment="Left"/>
                            <TextBlock Name="ProjectProgressText" Classes="muted" Margin="0,6,0,2"/>
                            <TextBlock Name="ProjectTimeText" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>

                            <TextBlock Classes="label" Text="GOALS" Margin="0,0,0,6"/>
                            <ItemsControl Name="ProjectGoals" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete}" MinWidth="0" Click="ProjectGoal_Click"
                                                              IsVisible="{Binding !SubGoals.Count}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Completion, StringFormat={}{0:P0}}" Foreground="{DynamicResource HazardBrush}"
                                                               Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding !!SubGoals.Count}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Weight, StringFormat={}{0}%}" Classes="muted" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding SubGoals}" Margin="22,6,0,0" IsVisible="{Binding !!SubGoals.Count}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
                                                                <CheckBox IsChecked="{Binding IsComplete}" MinWidth="0" Click="ProjectGoal_Click"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Weight, StringFormat={}{0}%}" Classes="muted" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="ghost" Padding="10,6" Margin="0,-12,0,20" HorizontalAlignment="Left" Click="AddProjectGoal_Click"
                                    ToolTip.Tip="Add a goal to this project" AutomationProperties.Name="Add goal">
                                <StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="add" Width="14" Height="14"/><TextBlock Text="Add goal"/></StackPanel>
                            </Button>

                            <WrapPanel>
                                <Button Classes="primary" Padding="18,8" Margin="0,0,8,8" Click="StartProjectSession_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="play" Width="12" Height="12"/><TextBlock Text="Start Session"/></StackPanel>
                                </Button>
                                <Button Classes="icon" Margin="0,0,8,8" Click="LogTime_Click" ToolTip.Tip="Log time you worked away from BijouHub"><controls:LineIcon Kind="clock"/></Button>
                                <Button Classes="icon" Margin="0,0,8,8" Click="EditProject_Click" ToolTip.Tip="Edit project"><controls:LineIcon Kind="edit"/></Button>
                                <Button Classes="icon" Margin="0,0,8,8" Click="DeleteProject_Click" ToolTip.Tip="Delete project"><controls:LineIcon Kind="delete"/></Button>
                                <Button Name="ProjectNotesToggle" Classes="icon" Margin="0,0,8,8" Click="NotesToggle_Click" ToolTip.Tip="Hide notes"><controls:LineIcon Kind="note"/></Button>
                            </WrapPanel>

                            <TextBlock Classes="label" Text="SESSION NOTES" Margin="0,16,0,6" Name="ProjectNotesLabel"/>
                            <ItemsControl Name="ProjectNotesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                            <Run Text="{Binding Timestamp, StringFormat='{}{0:MMM d, HH:mm}'}" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Text}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>


                    <!-- Calendar: a month of due dates and worked time, or the same as a timeline. -->
                    <Grid Name="CalendarPanel" RowDefinitions="Auto,*" Margin="28,26,28,20" IsVisible="False">
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel Name="CalendarControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                            <TextBlock Name="CalendarTitle" Classes="h1" Foreground="{DynamicResource AccentBrush}"/>
                        </DockPanel>
                        <Grid Name="CalendarBody" Grid.Row="1"/>
                    </Grid>

                    <!-- Tasks: every list, full size, like Microsoft To Do. -->
                    <Grid Name="TasksPanel" ColumnDefinitions="230,*" Margin="28,26,28,20" IsVisible="False">
                        <ScrollViewer Grid.Column="0" Margin="0,0,18,0">
                            <StackPanel Name="TaskListsNav"/>
                        </ScrollViewer>
                        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                            <DockPanel Margin="0,0,0,16">
                                <Button Name="TasksRefreshButton" DockPanel.Dock="Right" Classes="ghost" Padding="6" Margin="4,0,0,0" VerticalAlignment="Bottom"
                                        Click="TasksRefresh_Click" ToolTip.Tip="Refresh tasks" AutomationProperties.Name="Refresh tasks">
                                    <controls:LineIcon Kind="refresh" Width="16" Height="16"/>
                                </Button>
                                <Button Name="TasksListMenuButton" DockPanel.Dock="Right" Classes="ghost" Padding="6" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                        Click="TasksListMenu_Click" ToolTip.Tip="List options" AutomationProperties.Name="List options">
                                    <controls:LineIcon Kind="more" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Name="TasksCountText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Classes="muted" Margin="0,0,0,6"/>
                                <TextBlock Name="TasksTitle" Classes="h1" Foreground="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" Padding="0,0,6,0">
                                <StackPanel>
                                    <ItemsControl Name="TasksOpenList">
                                        <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="taskcard" Padding="12,10" Margin="0,0,0,4" CornerRadius="6">
                                            <Border.ContextMenu>
                                                <ContextMenu Opening="GoalMenu_Opening"/>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <CheckBox IsChecked="{Binding Done}" MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Text}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Text}" Classes.done="{Binding Done}" FontSize="15" TextWrapping="Wrap"
                                                                   IsVisible="{Binding !IsEditing}" DoubleTapped="GoalText_DoubleTapped"/>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsVisible="{Binding IsEditing}" Padding="4,2" MinHeight="0"
                                                                 KeyDown="GoalEditor_KeyDown" LostFocus="GoalEditor_LostFocus"
                                                                 PropertyChanged="GoalEditor_PropertyChanged"/>
                                                    </Panel>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,3,0,0">
                                                        <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="GoalProjectChip_Click" ToolTip.Tip="Change the project"
                                                                AutomationProperties.Name="{Binding ProjectChip, StringFormat='Project: {0}'}"><StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                     Fill="{Binding ChannelColor, Converter={x:Static controls:HexBrushConverter.Instance}}"
                                                                     IsVisible="{Binding ChannelColor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            <TextBlock Text="{Binding ProjectChip}" FontSize="11" Classes="muted"/>
                                                        </StackPanel></Button>
                                                        <Border Classes="duechip" Classes.overdue="{Binding DueOverdue}" Background="Transparent" Cursor="Hand"
                                                                PointerPressed="GoalDueChip_PointerPressed"
                                                                IsVisible="{Binding DueChip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <controls:LineIcon Kind="calendar" Width="10" Height="10"/>
                                                                <TextBlock Text="{Binding DueChip}" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="ghost" Padding="5" Margin="8,0,2,0" Click="GoalDue_Click" ToolTip.Tip="Date and time"
                                                        VerticalAlignment="Center">
                                                    <controls:LineIcon Kind="calendar" Width="14" Height="14"/>
                                                </Button>
                                                <Button Grid.Column="3" Classes="ghost star" Classes.starred="{Binding Starred}" Padding="5"
                                                        Click="GoalStar_Click" ToolTip.Tip="Important" VerticalAlignment="Center">
                                                    <controls:LineIcon Kind="star" Width="16" Height="16" Filled="{Binding Starred}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Name="TasksEmptyText" Text="Nothing here. Add a task below." Classes="muted" Margin="2,6,0,0" IsVisible="False"/>
                                    <Button Name="TasksCompletedToggle" Classes="ghost" Padding="0" Margin="0,14,0,8" Click="TasksCompletedToggle_Click"
                                            AutomationProperties.Name="Completed">
                                        <TextBlock Name="TasksCompletedText" FontSize="12" Classes="muted"/>
                                    </Button>
                                    <ItemsControl Name="TasksDoneList" IsVisible="False">
                                        <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="taskcard" Padding="12,10" Margin="0,0,0,4" CornerRadius="6">
                                            <Border.ContextMenu>
                                                <ContextMenu Opening="GoalMenu_Opening"/>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <CheckBox IsChecked="{Binding Done}" MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Text}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Text}" Classes.done="{Binding Done}" FontSize="15" TextWrapping="Wrap"
                                                                   IsVisible="{Binding !IsEditing}" DoubleTapped="GoalText_DoubleTapped"/>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsVisible="{Binding IsEditing}" Padding="4,2" MinHeight="0"
                                                                 KeyDown="GoalEditor_KeyDown" LostFocus="GoalEditor_LostFocus"
                                                                 PropertyChanged="GoalEditor_PropertyChanged"/>
                                                    </Panel>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,3,0,0">
                                                        <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="GoalProjectChip_Click" ToolTip.Tip="Change the project"
                                                                AutomationProperties.Name="{Binding ProjectChip, StringFormat='Project: {0}'}"><StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                     Fill="{Binding ChannelColor, Converter={x:Static controls:HexBrushConverter.Instance}}"
                                                                     IsVisible="{Binding ChannelColor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            <TextBlock Text="{Binding ProjectChip}" FontSize="11" Classes="muted"/>
                                                        </StackPanel></Button>
                                                        <Border Classes="duechip" Classes.overdue="{Binding DueOverdue}" Background="Transparent" Cursor="Hand"
                                                                PointerPressed="GoalDueChip_PointerPressed"
                                                                IsVisible="{Binding DueChip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <controls:LineIcon Kind="calendar" Width="10" Height="10"/>
                                                                <TextBlock Text="{Binding DueChip}" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="ghost" Padding="5" Margin="8,0,2,0" Click="GoalDue_Click" ToolTip.Tip="Date and time"
                                                        VerticalAlignment="Center">
                                                    <controls:LineIcon Kind="calendar" Width="14" Height="14"/>
                                                </Button>
                                                <Button Grid.Column="3" Classes="ghost star" Classes.starred="{Binding Starred}" Padding="5"
                                                        Click="GoalStar_Click" ToolTip.Tip="Important" VerticalAlignment="Center">
                                                    <controls:LineIcon Kind="star" Width="16" Height="16" Filled="{Binding Starred}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="2" Classes="taskadd" CornerRadius="6" BorderThickness="1" Padding="14,0" MinHeight="46" Margin="0,10,6,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:LineIcon Kind="add" Width="16" Height="16" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}"/>
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Name="TasksInput" FontSize="14" KeyDown="TasksInput_KeyDown" TextChanged="TasksInput_TextChanged"
                                                 AutomationProperties.Name="Add a task to this list"/>
                                        <TextBlock Name="TasksInputPlaceholder" Text="Add a task" FontSize="14" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <Button Name="TasksDueButton" Grid.Column="2" Classes="ghost" Padding="6,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Click="TasksDue_Click" AutomationProperties.Name="Date and time for the new task">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LineIcon Kind="calendar" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Name="TasksDueText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" IsVisible="False"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Active session -->
                    <ScrollViewer Name="SessionPanel" Padding="28,26" IsVisible="False">
                        <StackPanel>
                            <TextBlock Name="SessionTitleText" Classes="h1" Margin="0,0,0,4"/>
                            <TextBlock Name="SessionContextText" Classes="muted" Margin="0,0,0,4"/>
                            <TextBlock Name="SessionStatusText" Classes="muted" Margin="0,0,0,22"/>
                            <TextBlock Name="SessionTimerText" FontFamily="{DynamicResource TimerFont}" FontSize="64" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,26"/>

                            <!-- Time's up: extend or finish, without leaving the page. -->
                            <Border Name="TimeUpBanner" Classes="card" Padding="14,10" Margin="0,0,0,20" IsVisible="False" MaxWidth="520" HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource HazardBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="+15 min" Click="Extend15_Click"/>
                                        <Button Content="Finish" Classes="primary" Click="FinishSession_Click"/>
                                    </StackPanel>
                                    <TextBlock Name="TimeUpText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                </DockPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Padding="16,8" Click="FinishSession_Click" ToolTip.Tip="Finish and log this session">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="stop" Width="13" Height="13"/><TextBlock Text="Finish"/></StackPanel>
                                </Button>
                                <Button Name="PauseButton" Classes="icon" Click="Pause_Click" ToolTip.Tip="Pause"><controls:LineIcon Name="PauseIcon" Kind="pause"/></Button>
                                <Button Name="SessionNotesToggle" Classes="icon" Click="NotesToggle_Click" ToolTip.Tip="Notes"><controls:LineIcon Kind="note"/></Button>
                                <Button Name="PopoutButton" Classes="icon" Click="Popout_Click" ToolTip.Tip="Pop out the timer"><controls:LineIcon Name="PopoutIcon" Kind="popout"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>

                <!-- Project notes (plain text, shared with the Windows app's NotesPlainText). -->
                <Border Name="NotesPanel" Grid.Column="1" Width="340" Margin="0,22,22,22" IsVisible="False">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Classes="label" Text="NOTES" Margin="2,0,0,8"/>
                        <TextBox Name="NotesBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Watermark="Notes for this project…" LostFocus="NotesBox_LostFocus"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
