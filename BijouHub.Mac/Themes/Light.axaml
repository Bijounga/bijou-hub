<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generated from Themes/Light.xaml by tools/themes/gen_mac_themes.py — edit the Windows theme and rerun. -->
    <x:String x:Key="ThemeVariantName">Light</x:String>
    <Color x:Key="BgColor">#ECECEE</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#ECECEE"/>
