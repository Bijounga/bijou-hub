<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BijouHub.Mac.Controls"
        x:Class="BijouHub.Mac.Views.ModeEditorWindow"
        Title="Mode" Width="520" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <TextBlock Text="NAME" Classes="label"/>
        <TextBox Name="NameBox" Grid.Row="1" Margin="0,4,0,18"/>

        <TextBlock Grid.Row="2" Text="OPENS WHEN YOU LAUNCH IT" Classes="label"/>
        <TextBlock Grid.Row="3" Classes="faint" Margin="0,2,0,8" TextWrapping="Wrap"
                   Text="Apps, folders, files or links — opened in this order. (Blocking apps is Windows-only.)"/>
        <ListBox Name="ItemsList" Grid.Row="4" Classes="nav">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="ghost" Padding="4" Click="RemoveItem_Click" ToolTip.Tip="Remove">
                            <controls:LineIcon Kind="close" Width="11" Height="11"/>
                        </Button>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Grid.Row="5" Margin="0,10,0,0">
            <Button Margin="0,0,8,0" Click="AddApp_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><controls:LineIcon Kind="app" Width="13" Height="13"/><TextBlock Text="App or file"/></StackPanel>
            </Button>
            <Button Margin="0,0,8,0" Click="AddFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><controls:LineIcon Kind="folder" Width="13" Height="13"/><TextBlock Text="Folder"/></StackPanel>
            </Button>
            <Button Click="AddLink_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><controls:LineIcon Kind="link" Width="13" Height="13"/><TextBlock Text="Link"/></StackPanel>
            </Button>
        </WrapPanel>

        <StackPanel Grid.Row="6" Margin="0,18,0,0" Spacing="16">
            <StackPanel Spacing="2">
                <CheckBox Name="DoNotDisturbBox" Content="Do Not Disturb while this mode runs"/>
                <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,0"
                           Text="Runs two Shortcuts you make once: &quot;BijouHub Focus On&quot; and &quot;BijouHub Focus Off&quot;, each a Set Focus action."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Width="90" HorizontalContentAlignment="Center" Click="Cancel_Click"/>
                <Button Content="Save" Classes="primary" Width="90" HorizontalContentAlignment="Center" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
