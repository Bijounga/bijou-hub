<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BijouHub.Models;assembly=BijouHub.Core"
        xmlns:views="clr-namespace:BijouHub.Mac.Views"
        xmlns:controls="clr-namespace:BijouHub.Mac.Controls"
        x:Class="BijouHub.Mac.Views.ProjectEditorWindow"
        Title="Edit Project" Width="680" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="PROJECT NAME" Classes="label"/>
            <TextBox Name="NameBox" FontSize="16" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnDefinitions="Auto,*">
            <StackPanel>
                <TextBlock Text="DEFAULT SESSION BUDGET (MINUTES, OPTIONAL)" Classes="label"/>
                <TextBox Name="BudgetBox" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <TextBlock Text="CHANNEL" Classes="label"/>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <ComboBox Name="ChannelCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Channel">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:Channel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={x:Static controls:HexBrushConverter.Instance}}"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="Manage…" Margin="8,0,0,0" Click="ManageChannels_Click" AutomationProperties.Name="Manage channels"/>
                </Grid>
                <CheckBox Name="MainBox" Content="Main project for this channel" Margin="0,8,0,0" AutomationProperties.Name="Main project for this channel"
                          ToolTip.Tip="The one you're working on now: starred, first in its channel, and badged on the board"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="GOALS" Classes="label" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Goal" Click="AddGoal_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="3">
            <ItemsControl Name="GoalsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Goal">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,60,Auto,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete}" Margin="0,0,8,0" VerticalAlignment="Center"
                                              IsVisible="{Binding SubGoals.Count, Converter={x:Static views:ProjectEditorWindow.IsZeroConverter}}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding Weight}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Weight %"/>
                                    <Button Grid.Column="3" Content="+ Sub" Padding="6,2" Margin="0,0,4,0" Click="AddSubGoal_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="4" Content="Remove" Padding="6,2" Click="RemoveGoal_Click" Tag="{Binding}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SubGoals}" Margin="30,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:Goal">
                                            <Grid ColumnDefinitions="Auto,*,60,Auto" Margin="0,0,0,6">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsComplete}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2" Text="{Binding Weight}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Weight %"/>
                                                <Button Grid.Column="3" Content="Remove" Padding="6,2" Click="RemoveSubGoal_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Classes="primary" Content="Save" Width="90" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
