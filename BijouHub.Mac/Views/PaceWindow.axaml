<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BijouHub.Mac.Views.PaceWindow"
        Title="Pace" Width="420" Height="340" WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Name="TaskText" Classes="h2" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="A steady step toward it. Time you put in with this task picked counts."/>

        <TextBlock Grid.Row="2" Text="HOW MUCH" Classes="label"/>
        <TextBox Grid.Row="3" Name="AmountBox" Margin="0,4,0,12" Watermark="Like 1h, 45 or 1:30"/>

        <TextBlock Grid.Row="4" Text="HOW OFTEN" Classes="label"/>
        <ComboBox Grid.Row="5" Name="RhythmBox" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="RemoveButton" Content="Remove pace" IsVisible="False" Click="Remove_Click"/>
            <Button Content="Cancel" Width="90" HorizontalContentAlignment="Center" Click="Cancel_Click"/>
            <Button Content="Save" Classes="primary" Width="90" HorizontalContentAlignment="Center" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
