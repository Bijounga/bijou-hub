<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BijouHub.Mac.Views.SessionLogWindow"
        Title="Session Log" Width="700" Height="580" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="18" RowDefinitions="Auto,Auto,*">
        <TextBlock Classes="h2" Text="Session Log" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Name="UnassignedSummary" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
            <CheckBox Name="UnassignedOnlyCheck" DockPanel.Dock="Right" Content="Unassigned only" IsCheckedChanged="UnassignedOnly_Changed"/>
        </DockPanel>
        <!-- Virtualized: a long history only builds the days on screen. -->
        <ListBox Name="LogItems" Grid.Row="2" Background="Transparent">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</Window>
