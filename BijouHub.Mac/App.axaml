<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BijouHub.Mac.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#030405"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#08090B"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0C0F10"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#121819"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2E3B3D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8F6FA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5C7A80"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#33E1FF"/>
        <SolidColorBrush x:Key="HazardBrush" Color="#FF9A2E"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#1A33E1FF"/>
        <SolidColorBrush x:Key="AccentButtonBgBrush" Color="#332FE0FF"/>

        <FontFamily x:Key="HeadingFont">avares://BijouHub.Mac/Assets/Fonts#Rajdhani SemiBold</FontFamily>
        <FontFamily x:Key="BodyFont">avares://BijouHub.Mac/Assets/Fonts#IBM Plex Mono</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style Selector="TextBlock.heading">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Buttons: dark glass with cyan border, corner ticks, hover glow -->
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                BoxShadow="0 0 5 0 #7333E1FF">
                            <Border.Transitions>
                                <Transitions>
                                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Line StartPoint="0,0" EndPoint="7,0" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Line StartPoint="0,0" EndPoint="0,7" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Line StartPoint="0,0" EndPoint="7,0" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <Line StartPoint="0,0" EndPoint="0,7" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Bd">
            <Setter Property="BoxShadow" Value="0 0 16 0 #F033E1FF"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentButtonBgBrush}"/>
            <Setter Property="Foreground" Value="#F5FAFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- TextBox -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="#4433E1FF"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ListBox / ListBoxItem: card look -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                            CornerRadius="2" Padding="10,8">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ProgressBar as a thin accent fill -->
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- CheckBox: cyan box, check glyph -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Styles>
</Application>
