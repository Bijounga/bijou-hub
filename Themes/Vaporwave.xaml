<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vaporwave theme — one of BijouHub's selectable themes (Services/ThemeService.cs).
         Token values ported from BijouDocs' src/styles.css :root[data-theme='Vaporwave'] block,
         translated into this project's resource-key naming. -->

    <Color x:Key="BgColor">#D7C2F5</Color>
    <Color x:Key="PanelColor">#E8D9FF</Color>
    <Color x:Key="CardColor">#F6EDFF</Color>
    <Color x:Key="CardHoverColor">#D7C2F5</Color>
    <Color x:Key="TextColor">#2A1A4A</Color>
    <Color x:Key="MutedTextColor">#4F3D78</Color>
    <Color x:Key="FaintTextColor">#6A5794</Color>
    <Color x:Key="BorderColor">#B99BE6</Color>
    <Color x:Key="SoftBorderColor">#D9C8F3</Color>
    <Color x:Key="AccentColor">#E0359B</Color>
    <Color x:Key="HazardColor">#C96F00</Color>
    <Color x:Key="PinkColor">#8A3AD9</Color>
    <Color x:Key="DangerColor">#D6204E</Color>
    <Color x:Key="SuccessColor">#0F9D74</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>

    <FontFamily x:Key="HeadingFont">Trebuchet MS, Segoe UI, Verdana</FontFamily>
    <FontFamily x:Key="BodyFont">Trebuchet MS, Segoe UI, Verdana</FontFamily>

    <CornerRadius x:Key="CornerRadiusBase">4</CornerRadius>
</ResourceDictionary>
