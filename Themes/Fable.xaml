<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Fable — a storybook on aged parchment: sepia ink, wax-seal red, Palatino.
         Pairs with Styles/ControlsFx.xaml. Generated by tools/themes/gen_fx_themes.py — edit the
         spec there and re-run rather than editing this file by hand. -->

    <Color x:Key="BgColor">#E8D9AB</Color>
    <Color x:Key="PanelColor">#EFE2B8</Color>
    <Color x:Key="CardColor">#D9FBF4DC</Color>
    <Color x:Key="CardHoverColor">#FFF8E4</Color>
    <Color x:Key="TextColor">#3B2A17</Color>
    <Color x:Key="MutedTextColor">#6B4F30</Color>
    <Color x:Key="FaintTextColor">#8A6D47</Color>
    <Color x:Key="BorderColor">#A88A5A</Color>
    <Color x:Key="SoftBorderColor">#D6C190</Color>
    <Color x:Key="AccentColor">#9C2B2B</Color>
    <Color x:Key="HazardColor">#8A5A10</Color>
    <Color x:Key="PinkColor">#7A3B52</Color>
    <Color x:Key="DangerColor">#8E1F1F</Color>
    <Color x:Key="SuccessColor">#4A6329</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <FontFamily x:Key="HeadingFont">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <FontFamily x:Key="BodyFont">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <CornerRadius x:Key="CornerRadiusBase">4</CornerRadius>
    <FontWeight x:Key="HeadingFontWeight">Bold</FontWeight>
    <Color x:Key="TitleBarColor">#D6C08A</Color>
    <Color x:Key="TitleBarTextColor">#3B2A17</Color>
    <ImageBrush x:Key="WallpaperBrush" ImageSource="pack://application:,,,/Assets/Themes/fable.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F0F2E6C4"/>
    <SolidColorBrush x:Key="SidebarEdgeBrush" Color="#8F7248"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#EBF6ECCE"/>
    <SolidColorBrush x:Key="ContentEdgeBrush" Color="#8F7248"/>
    <Thickness x:Key="SidebarBorderThickness">1.5</Thickness>
    <Thickness x:Key="ContentBorderThickness">1.5</Thickness>
    <Thickness x:Key="PanelInset">1.5</Thickness>
    <CornerRadius x:Key="PanelRadius">6</CornerRadius>
    <CornerRadius x:Key="PanelTopRadius">5,5,0,0</CornerRadius>
    <DropShadowEffect x:Key="PanelShadow" x:Shared="False" Color="#3B2A17" BlurRadius="18" ShadowDepth="6" Opacity="0.35" Direction="270"/>
    <LinearGradientBrush x:Key="SidebarHeaderBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E4D09D" Offset="0"/><GradientStop Color="#D6BE86" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarHeaderEdgeBrush" Color="#8F7248"/>
    <Thickness x:Key="SidebarHeaderBorderThickness">0,0,0,2</Thickness>
    <SolidColorBrush x:Key="SidebarHeaderInkBrush" Color="#3B2A17"/>
    <LinearGradientBrush x:Key="FxBtnBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FAF2D8" Offset="0"/><GradientStop Color="#E9D9AA" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="#8F7248"/>
    <CornerRadius x:Key="FxBtnRadius">4</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">6</CornerRadius>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="#3B2A17"/>
    <SolidColorBrush x:Key="FxBtnSheenBrush" Color="#99FFFFFF"/>
    <DropShadowEffect x:Key="FxBtnShadow" x:Shared="False" Color="#3B2A17" BlurRadius="2" ShadowDepth="1" Opacity="0.25" Direction="270"/>
    <DropShadowEffect x:Key="FxBtnHoverEffect" x:Shared="False" Color="#C9A055" BlurRadius="10" ShadowDepth="0" Opacity="0.6" Direction="270"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#8CFFF6DA"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#2E8F7248"/>
    <TranslateTransform x:Key="FxPressTransform" X="0" Y="1"/>
    <LinearGradientBrush x:Key="FxPrimaryBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B54040" Offset="0"/><GradientStop Color="#8A2222" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="#5E1515"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="#FBEFD0"/>
    <DropShadowEffect x:Key="FxPrimaryShadow" x:Shared="False" Color="#3B2A17" BlurRadius="3" ShadowDepth="1" Opacity="0.35" Direction="270"/>
    <DropShadowEffect x:Key="FxPrimaryHoverEffect" x:Shared="False" Color="#B54040" BlurRadius="10" ShadowDepth="0" Opacity="0.5" Direction="270"/>
    <SolidColorBrush x:Key="FxRowBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="FxRowRadius">3</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="#BFFFF6DA"/>
    <SolidColorBrush x:Key="FxSelectedBrush" Color="#E2CC93"/>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="#9C2B2B"/>
    <Thickness x:Key="FxSelectedBorderThickness">3,0,0,0</Thickness>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="#3B2A17"/>
    <SolidColorBrush x:Key="FxFieldBrush" Color="#FDF8E8"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="#A88A5A"/>
    <CornerRadius x:Key="FxFieldRadius">3</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="#3B2A17"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="#9C2B2B"/>
    <SolidColorBrush x:Key="FxPopupBrush" Color="#FBF4DC"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="#8F7248"/>
    <CornerRadius x:Key="FxPopupRadius">4</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#3B2A17" BlurRadius="14" ShadowDepth="4" Opacity="0.35" Direction="270"/>
    <SolidColorBrush x:Key="FxCheckBrush" Color="#FDF8E8"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="#8F7248"/>
    <CornerRadius x:Key="FxCheckRadius">2</CornerRadius>
    <SolidColorBrush x:Key="FxCheckOnBrush" Color="#9C2B2B"/>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="#5E1515"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="#FBEFD0"/>
    <SolidColorBrush x:Key="FxThumbBrush" Color="#B49A6A"/>
    <CornerRadius x:Key="FxThumbRadius">3</CornerRadius>
    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B54040" Offset="0"/><GradientStop Color="#8A2222" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#8E2424"/>
    <FontFamily x:Key="TimerFont">Palatino Linotype</FontFamily>
    <FontWeight x:Key="TimerFontWeight">Bold</FontWeight>
    <DropShadowEffect x:Key="TimerGlow" x:Shared="False" Color="#FFF6DA" BlurRadius="0" ShadowDepth="1" Opacity="0.9" Direction="270"/>
</ResourceDictionary>
