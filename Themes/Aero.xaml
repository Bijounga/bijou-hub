<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aero theme — one of BijouHub's selectable themes (Services/ThemeService.cs).
         Token values ported from BijouDocs' src/styles.css :root[data-theme='Aero'] block,
         translated into this project's resource-key naming. -->

    <Color x:Key="BgColor">#D3ECFB</Color>
    <Color x:Key="PanelColor">#EAF6FF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#D3ECFB</Color>
    <Color x:Key="TextColor">#0B2545</Color>
    <Color x:Key="MutedTextColor">#35516B</Color>
    <Color x:Key="FaintTextColor">#5C7791</Color>
    <Color x:Key="BorderColor">#BCDCF0</Color>
    <Color x:Key="SoftBorderColor">#D8EDFA</Color>
    <Color x:Key="AccentColor">#0F9FDB</Color>
    <Color x:Key="HazardColor">#F2A71B</Color>
    <Color x:Key="PinkColor">#E75BA0</Color>
    <Color x:Key="DangerColor">#E2432F</Color>
    <Color x:Key="SuccessColor">#2FB866</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>

    <FontFamily x:Key="HeadingFont">Segoe UI, Segoe UI Light, Tahoma, Verdana</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI, Segoe UI Light, Tahoma, Verdana</FontFamily>

    <CornerRadius x:Key="CornerRadiusBase">14</CornerRadius>
</ResourceDictionary>
