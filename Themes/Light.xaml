<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MacBook Light — a soft macOS desktop: frosted white windows, hairlines, system blue.
         Pairs with Styles/ControlsFx.xaml. Generated by tools/themes/gen_fx_themes.py — edit the
         spec there and re-run rather than editing this file by hand. -->

    <Color x:Key="BgColor">#ECECEE</Color>
    <Color x:Key="PanelColor">#F5F5F7</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#F5F5F7</Color>
    <Color x:Key="TextColor">#1D1D1F</Color>
    <Color x:Key="MutedTextColor">#6E6E73</Color>
    <Color x:Key="FaintTextColor">#8E8E93</Color>
    <Color x:Key="BorderColor">#1F000000</Color>
    <Color x:Key="SoftBorderColor">#E5E5EA</Color>
    <Color x:Key="AccentColor">#0A64C8</Color>
    <Color x:Key="HazardColor">#B26A00</Color>
    <Color x:Key="PinkColor">#D6174A</Color>
    <Color x:Key="DangerColor">#C41E1E</Color>
    <Color x:Key="SuccessColor">#1E7A35</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <FontFamily x:Key="HeadingFont">Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <CornerRadius x:Key="CornerRadiusBase">8</CornerRadius>
    <Color x:Key="TitleBarColor">#ECECEE</Color>
    <Color x:Key="TitleBarTextColor">#1D1D1F</Color>
    <ImageBrush x:Key="WallpaperBrush" ImageSource="pack://application:,,,/Assets/Themes/mac.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Thickness x:Key="ShellPadding">10</Thickness>
    <Thickness x:Key="SidebarMargin">0,0,10,0</Thickness>
    <SolidColorBrush x:Key="SidebarBrush" Color="#DBF2F2F5"/>
    <SolidColorBrush x:Key="SidebarEdgeBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="ContentEdgeBrush" Color="#14000000"/>
    <DropShadowEffect x:Key="PanelShadow" x:Shared="False" Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.12" Direction="270"/>
    <SolidColorBrush x:Key="SidebarHeaderEdgeBrush" Color="#00000000"/>
    <Thickness x:Key="SidebarHeaderBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="FxBtnBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="#1F000000"/>
    <CornerRadius x:Key="FxBtnRadius">6</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">12</CornerRadius>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="#1D1D1F"/>
    <DropShadowEffect x:Key="FxBtnShadow" x:Shared="False" Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.1" Direction="270"/>
    <DropShadowEffect x:Key="FxBtnHoverEffect" x:Shared="False" Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.14" Direction="270"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#08000000"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#14000000"/>
    <LinearGradientBrush x:Key="FxPrimaryBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2F86E8" Offset="0"/><GradientStop Color="#0A64C8" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="#0956AC"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="#FFFFFF"/>
    <DropShadowEffect x:Key="FxPrimaryShadow" x:Shared="False" Color="#0A64C8" BlurRadius="3" ShadowDepth="1" Opacity="0.25" Direction="270"/>
    <DropShadowEffect x:Key="FxPrimaryHoverEffect" x:Shared="False" Color="#0A64C8" BlurRadius="6" ShadowDepth="1" Opacity="0.35" Direction="270"/>
    <SolidColorBrush x:Key="FxRowBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="FxRowRadius">6</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="FxSelectedBrush" Color="#0A64C8"/>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="#0A64C8"/>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxFieldBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="#26000000"/>
    <CornerRadius x:Key="FxFieldRadius">6</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="#0A64C8"/>
    <DropShadowEffect x:Key="FxFieldFocusGlow" x:Shared="False" Color="#0A64C8" BlurRadius="6" ShadowDepth="0" Opacity="0.45" Direction="270"/>
    <SolidColorBrush x:Key="FxPopupBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="#1A000000"/>
    <CornerRadius x:Key="FxPopupRadius">8</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.18" Direction="270"/>
    <SolidColorBrush x:Key="FxCheckBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="#40000000"/>
    <CornerRadius x:Key="FxCheckRadius">4</CornerRadius>
    <SolidColorBrush x:Key="FxCheckOnBrush" Color="#0A64C8"/>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="#0A64C8"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxThumbBrush" Color="#59000000"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#0A64C8"/>
    <FontFamily x:Key="TimerFont">Segoe UI</FontFamily>
    <FontWeight x:Key="TimerFontWeight">Light</FontWeight>
</ResourceDictionary>
