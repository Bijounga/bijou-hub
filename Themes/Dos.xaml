<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dos theme — one of BijouHub's selectable themes (Services/ThemeService.cs).
         Token values ported from BijouDocs' src/styles.css :root[data-theme='Dos'] block,
         translated into this project's resource-key naming. -->

    <Color x:Key="BgColor">#A0A0A0</Color>
    <Color x:Key="PanelColor">#C0C0C0</Color>
    <Color x:Key="CardColor">#D4D0C8</Color>
    <Color x:Key="CardHoverColor">#A0A0A0</Color>
    <Color x:Key="TextColor">#000000</Color>
    <Color x:Key="MutedTextColor">#303030</Color>
    <Color x:Key="FaintTextColor">#4D4D4D</Color>
    <Color x:Key="BorderColor">#808080</Color>
    <Color x:Key="SoftBorderColor">#A0A0A0</Color>
    <Color x:Key="AccentColor">#000080</Color>
    <Color x:Key="HazardColor">#808000</Color>
    <Color x:Key="PinkColor">#800080</Color>
    <Color x:Key="DangerColor">#FF0000</Color>
    <Color x:Key="SuccessColor">#008000</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>

    <FontFamily x:Key="HeadingFont">Tahoma, MS Sans Serif, Verdana, Arial</FontFamily>
    <FontFamily x:Key="BodyFont">Tahoma, MS Sans Serif, Verdana, Arial</FontFamily>

    <CornerRadius x:Key="CornerRadiusBase">0</CornerRadius>
</ResourceDictionary>
