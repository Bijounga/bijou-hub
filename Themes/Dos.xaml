<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MS-DOS — Windows 95 plates over the clouds: bevels, navy title bar, square everything.
         Pairs with Styles/ControlsFx.xaml. Generated by tools/themes/gen_fx_themes.py — edit the
         spec there and re-run rather than editing this file by hand. -->

    <Color x:Key="BgColor">#C0C0C0</Color>
    <Color x:Key="PanelColor">#C0C0C0</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#E8E8E8</Color>
    <Color x:Key="TextColor">#000000</Color>
    <Color x:Key="MutedTextColor">#303030</Color>
    <Color x:Key="FaintTextColor">#4D4D4D</Color>
    <Color x:Key="BorderColor">#808080</Color>
    <Color x:Key="SoftBorderColor">#A0A0A0</Color>
    <Color x:Key="AccentColor">#000080</Color>
    <Color x:Key="HazardColor">#808000</Color>
    <Color x:Key="PinkColor">#800080</Color>
    <Color x:Key="DangerColor">#C00000</Color>
    <Color x:Key="SuccessColor">#008000</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <FontFamily x:Key="HeadingFont">Tahoma, MS Sans Serif, Verdana</FontFamily>
    <FontFamily x:Key="BodyFont">Tahoma, MS Sans Serif, Verdana</FontFamily>
    <CornerRadius x:Key="CornerRadiusBase">0</CornerRadius>
    <FontWeight x:Key="HeadingFontWeight">Bold</FontWeight>
    <Color x:Key="TitleBarColor">#000080</Color>
    <Color x:Key="TitleBarTextColor">#FFFFFF</Color>
    <ImageBrush x:Key="WallpaperBrush" ImageSource="pack://application:,,,/Assets/Themes/dos.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="SidebarEdgeBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ContentEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="PanelRadius">0</CornerRadius>
    <CornerRadius x:Key="PanelTopRadius">0</CornerRadius>
    <Thickness x:Key="PanelInset">3</Thickness>
    <Visibility x:Key="PanelBevelVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="PanelBevelOuterLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBevelOuterDarkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="PanelBevelInnerLightBrush" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="PanelBevelInnerDarkBrush" Color="#808080"/>
    <LinearGradientBrush x:Key="SidebarHeaderBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#000080" Offset="0"/><GradientStop Color="#1084D0" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarHeaderInkBrush" Color="#FFFFFF"/>
    <Thickness x:Key="SidebarHeaderBorderThickness">0</Thickness>
    <Thickness x:Key="SidebarHeaderPadding">4,3,4,3</Thickness>
    <Thickness x:Key="LogoMargin">2,1,2,1</Thickness>
    <sys:Double x:Key="LogoFontSize">14</sys:Double>
    <Visibility x:Key="FxBevelVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="FxBevelOuterLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxBevelOuterDarkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxBevelInnerLightBrush" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="FxBevelInnerDarkBrush" Color="#808080"/>
    <SolidColorBrush x:Key="FxBevelPressedOuterLightBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxBevelPressedOuterDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxBevelPressedInnerLightBrush" Color="#808080"/>
    <SolidColorBrush x:Key="FxBevelPressedInnerDarkBrush" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="FxBevelSunkenOuterLightBrush" Color="#808080"/>
    <SolidColorBrush x:Key="FxBevelSunkenOuterDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxBevelSunkenInnerLightBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxBevelSunkenInnerDarkBrush" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="FxBtnBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="#00000000"/>
    <Thickness x:Key="FxBtnBorderThickness">0</Thickness>
    <CornerRadius x:Key="FxBtnRadius">0</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">0</CornerRadius>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#00000000"/>
    <TranslateTransform x:Key="FxPressTransform" X="0" Y="1"/>
    <SolidColorBrush x:Key="FxPrimaryBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxRowBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="FxRowRadius">0</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="#1A000080"/>
    <SolidColorBrush x:Key="FxSelectedBrush" Color="#000080"/>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="#000080"/>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxFieldBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="#00000000"/>
    <Thickness x:Key="FxFieldBorderThickness">0</Thickness>
    <CornerRadius x:Key="FxFieldRadius">0</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="FxPopupBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="#000000"/>
    <CornerRadius x:Key="FxPopupRadius">0</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#000000" BlurRadius="0" ShadowDepth="2" Opacity="0.5" Direction="315"/>
    <SolidColorBrush x:Key="FxCheckBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="FxCheckRadius">0</CornerRadius>
    <SolidColorBrush x:Key="FxCheckOnBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="FxThumbBrush" Color="#C0C0C0"/>
    <CornerRadius x:Key="FxThumbRadius">0</CornerRadius>
    <DrawingBrush x:Key="FxTrackBrush" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Stretch="None"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#C0C0C0"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2,2"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="1,1,1,1"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
    <DrawingBrush x:Key="ProgressFillBrush" TileMode="Tile" Viewport="0,0,10,14" ViewportUnits="Absolute" Stretch="None"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,14"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#000080"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,1,8,12"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
    <SolidColorBrush x:Key="TimerScreenBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TimerScreenEdgeBrush" Color="#808080"/>
    <Thickness x:Key="TimerScreenBorderThickness">2</Thickness>
    <Thickness x:Key="TimerScreenPadding">18,4,18,6</Thickness>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="TimerScreenInkBrush" Color="#808080"/>
    <SolidColorBrush x:Key="PopoutScreenBrush" Color="#000000"/>
    <FontFamily x:Key="TimerFont">Lucida Console, Consolas</FontFamily>
    <FontWeight x:Key="TimerFontWeight">Normal</FontWeight>
</ResourceDictionary>
