<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Doodle Club — Bijou Doodle's blue doodle wallpaper, cream paper, ink outlines, felt-tip logo.
         Pairs with Styles/ControlsFx.xaml. Generated by tools/themes/gen_fx_themes.py — edit the
         spec there and re-run rather than editing this file by hand. -->

    <Color x:Key="BgColor">#FFFBE9</Color>
    <Color x:Key="PanelColor">#FFFBE9</Color>
    <Color x:Key="CardColor">#FFFDF4</Color>
    <Color x:Key="CardHoverColor">#FFF0A8</Color>
    <Color x:Key="TextColor">#202031</Color>
    <Color x:Key="MutedTextColor">#4A4A66</Color>
    <Color x:Key="FaintTextColor">#6E6E8A</Color>
    <Color x:Key="BorderColor">#27283B</Color>
    <Color x:Key="SoftBorderColor">#D8D2B4</Color>
    <Color x:Key="AccentColor">#1F5FBF</Color>
    <Color x:Key="HazardColor">#C77A00</Color>
    <Color x:Key="PinkColor">#B92A65</Color>
    <Color x:Key="DangerColor">#C0392B</Color>
    <Color x:Key="SuccessColor">#258026</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <FontFamily x:Key="HeadingFont">Comic Sans MS, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Comic Sans MS, Segoe UI</FontFamily>
    <CornerRadius x:Key="CornerRadiusBase">8</CornerRadius>
    <FontWeight x:Key="HeadingFontWeight">Bold</FontWeight>
    <Color x:Key="TitleBarColor">#FFFBE9</Color>
    <Color x:Key="TitleBarTextColor">#202031</Color>
    <ImageBrush x:Key="WallpaperBrush" ImageSource="pack://application:,,,/Assets/Themes/doodle-tile.png" TileMode="Tile" Stretch="Fill" Viewport="0,0,400,400" ViewportUnits="Absolute" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Thickness x:Key="ShellPadding">12</Thickness>
    <Thickness x:Key="SidebarMargin">0,0,12,0</Thickness>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFBE9"/>
    <SolidColorBrush x:Key="SidebarEdgeBrush" Color="#27283B"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#FFFBE9"/>
    <SolidColorBrush x:Key="ContentEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="SidebarBorderThickness">2.5</Thickness>
    <Thickness x:Key="ContentBorderThickness">2.5</Thickness>
    <Thickness x:Key="PanelInset">2.5</Thickness>
    <CornerRadius x:Key="PanelRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelTopRadius">10,10,0,0</CornerRadius>
    <DropShadowEffect x:Key="PanelShadow" x:Shared="False" Color="#172B50" BlurRadius="0" ShadowDepth="3" Opacity="0.55" Direction="270"/>
    <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#FFFBE9"/>
    <SolidColorBrush x:Key="SidebarHeaderEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="SidebarHeaderBorderThickness">0,0,0,2</Thickness>
    <SolidColorBrush x:Key="SidebarHeaderInkBrush" Color="#1F5FBF"/>
    <Visibility x:Key="LogoStandardVisibility">Collapsed</Visibility>
    <Visibility x:Key="LogoDoodleVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="FxBtnBrush" Color="#FFFBE9"/>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="FxBtnBorderThickness">1.5</Thickness>
    <CornerRadius x:Key="FxBtnRadius">6</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">10</CornerRadius>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="#202031"/>
    <SolidColorBrush x:Key="FxBtnSheenBrush" Color="#FFFFFF"/>
    <DropShadowEffect x:Key="FxBtnShadow" x:Shared="False" Color="#CBC5A7" BlurRadius="0" ShadowDepth="2" Opacity="1.0" Direction="270"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#8CFFE45C"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#73FFD21E"/>
    <TranslateTransform x:Key="FxPressTransform" X="0" Y="1"/>
    <SolidColorBrush x:Key="FxPrimaryBrush" Color="#FFE45C"/>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="#202031"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="#202031"/>
    <DropShadowEffect x:Key="FxPrimaryShadow" x:Shared="False" Color="#D4AD26" BlurRadius="0" ShadowDepth="3" Opacity="1.0" Direction="270"/>
    <DropShadowEffect x:Key="FxPrimaryHoverEffect" x:Shared="False" Color="#D4AD26" BlurRadius="0" ShadowDepth="3" Opacity="1.0" Direction="270"/>
    <SolidColorBrush x:Key="FxRowBrush" Color="#FFFDF4"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="FxRowBorderThickness">1.5</Thickness>
    <CornerRadius x:Key="FxRowRadius">6</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="#FFF0A8"/>
    <SolidColorBrush x:Key="FxSelectedBrush" Color="#CFE3FF"/>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="FxSelectedBorderThickness">2</Thickness>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="#13284D"/>
    <SolidColorBrush x:Key="FxFieldBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="FxFieldBorderThickness">1.5</Thickness>
    <CornerRadius x:Key="FxFieldRadius">6</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="#202031"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="#1F5FBF"/>
    <SolidColorBrush x:Key="FxPopupBrush" Color="#FFFDF4"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="#27283B"/>
    <CornerRadius x:Key="FxPopupRadius">8</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#172B50" BlurRadius="0" ShadowDepth="3" Opacity="0.55" Direction="270"/>
    <SolidColorBrush x:Key="FxCheckBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="#27283B"/>
    <CornerRadius x:Key="FxCheckRadius">4</CornerRadius>
    <SolidColorBrush x:Key="FxCheckOnBrush" Color="#CFE3FF"/>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="#27283B"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="#13284D"/>
    <SolidColorBrush x:Key="FxThumbBrush" Color="#8FB3E8"/>
    <SolidColorBrush x:Key="FxThumbEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="FxThumbBorderThickness">1.5</Thickness>
    <CornerRadius x:Key="FxThumbRadius">4</CornerRadius>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#FFE45C"/>
    <SolidColorBrush x:Key="TimerScreenBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TimerScreenEdgeBrush" Color="#27283B"/>
    <Thickness x:Key="TimerScreenBorderThickness">2.5</Thickness>
    <CornerRadius x:Key="TimerScreenRadius">12</CornerRadius>
    <Thickness x:Key="TimerScreenPadding">22,2,22,6</Thickness>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#1F5FBF"/>
    <FontFamily x:Key="TimerFont">Comic Sans MS</FontFamily>
    <FontWeight x:Key="TimerFontWeight">Bold</FontWeight>
</ResourceDictionary>
