<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Midnight — a quiet night sky with a teal aurora; dark glass, nothing loud.
         Pairs with Styles/ControlsFx.xaml. Generated by tools/themes/gen_fx_themes.py — edit the
         spec there and re-run rather than editing this file by hand. -->

    <Color x:Key="BgColor">#0A0B0D</Color>
    <Color x:Key="PanelColor">#0F1014</Color>
    <Color x:Key="CardColor">#D916181E</Color>
    <Color x:Key="CardHoverColor">#1C1F27</Color>
    <Color x:Key="TextColor">#ECE9E2</Color>
    <Color x:Key="MutedTextColor">#9A9DA6</Color>
    <Color x:Key="FaintTextColor">#63656F</Color>
    <Color x:Key="BorderColor">#262A33</Color>
    <Color x:Key="SoftBorderColor">#1A1B21</Color>
    <Color x:Key="AccentColor">#4FD1C5</Color>
    <Color x:Key="HazardColor">#F2A65A</Color>
    <Color x:Key="PinkColor">#D46FB0</Color>
    <Color x:Key="DangerColor">#E2665B</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <FontFamily x:Key="HeadingFont">Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <CornerRadius x:Key="CornerRadiusBase">8</CornerRadius>
    <Color x:Key="TitleBarColor">#07090E</Color>
    <Color x:Key="TitleBarTextColor">#ECE9E2</Color>
    <ImageBrush x:Key="WallpaperBrush" ImageSource="pack://application:,,,/Assets/Themes/midnight.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E00D0F14"/>
    <SolidColorBrush x:Key="SidebarEdgeBrush" Color="#244FD1C5"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#D60B0D12"/>
    <SolidColorBrush x:Key="ContentEdgeBrush" Color="#244FD1C5"/>
    <DropShadowEffect x:Key="PanelShadow" x:Shared="False" Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.6" Direction="270"/>
    <SolidColorBrush x:Key="SidebarHeaderEdgeBrush" Color="#1F4FD1C5"/>
    <SolidColorBrush x:Key="SidebarHeaderInkBrush" Color="#ECE9E2"/>
    <SolidColorBrush x:Key="FxBtnBrush" Color="#EB1A1D24"/>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="#2A2E38"/>
    <CornerRadius x:Key="FxBtnRadius">8</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">12</CornerRadius>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="#ECE9E2"/>
    <SolidColorBrush x:Key="FxBtnSheenBrush" Color="#0DFFFFFF"/>
    <DropShadowEffect x:Key="FxBtnHoverEffect" x:Shared="False" Color="#4FD1C5" BlurRadius="12" ShadowDepth="0" Opacity="0.35" Direction="270"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#124FD1C5"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="FxPrimaryBrush" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="#06120F"/>
    <DropShadowEffect x:Key="FxPrimaryShadow" x:Shared="False" Color="#4FD1C5" BlurRadius="10" ShadowDepth="0" Opacity="0.3" Direction="270"/>
    <DropShadowEffect x:Key="FxPrimaryHoverEffect" x:Shared="False" Color="#4FD1C5" BlurRadius="16" ShadowDepth="0" Opacity="0.55" Direction="270"/>
    <SolidColorBrush x:Key="FxRowBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="FxRowRadius">7</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="FxSelectedBrush" Color="#244FD1C5"/>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="#994FD1C5"/>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="#ECE9E2"/>
    <SolidColorBrush x:Key="FxFieldBrush" Color="#0F1116"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="#262A33"/>
    <CornerRadius x:Key="FxFieldRadius">8</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="#ECE9E2"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="#4FD1C5"/>
    <DropShadowEffect x:Key="FxFieldFocusGlow" x:Shared="False" Color="#4FD1C5" BlurRadius="8" ShadowDepth="0" Opacity="0.3" Direction="270"/>
    <SolidColorBrush x:Key="FxPopupBrush" Color="#12141A"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="#262A33"/>
    <CornerRadius x:Key="FxPopupRadius">8</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#000000" BlurRadius="22" ShadowDepth="8" Opacity="0.6" Direction="270"/>
    <SolidColorBrush x:Key="FxCheckBrush" Color="#0F1116"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="#3A3F4A"/>
    <SolidColorBrush x:Key="FxCheckOnBrush" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="#4FD1C5"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="#06120F"/>
    <SolidColorBrush x:Key="FxThumbBrush" Color="#3A3F4A"/>
    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#4FD1C5" Offset="0"/><GradientStop Color="#3C9EC8" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#4FD1C5"/>
    <FontFamily x:Key="TimerFont">Segoe UI</FontFamily>
    <FontWeight x:Key="TimerFontWeight">Light</FontWeight>
    <DropShadowEffect x:Key="TimerGlow" x:Shared="False" Color="#4FD1C5" BlurRadius="20" ShadowDepth="0" Opacity="0.45" Direction="270"/>
</ResourceDictionary>
