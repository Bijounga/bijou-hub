<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Studio — a modern editing suite lit violet and blue from the edges (Bijou Footage).
         Pairs with Styles/ControlsFx.xaml. Generated by tools/themes/gen_fx_themes.py — edit the
         spec there and re-run rather than editing this file by hand. -->

    <Color x:Key="BgColor">#0D1020</Color>
    <Color x:Key="PanelColor">#141830</Color>
    <Color x:Key="CardColor">#1A1E36</Color>
    <Color x:Key="CardHoverColor">#232847</Color>
    <Color x:Key="TextColor">#E9EBF5</Color>
    <Color x:Key="MutedTextColor">#9AA0C0</Color>
    <Color x:Key="FaintTextColor">#6B7194</Color>
    <Color x:Key="BorderColor">#2A2F52</Color>
    <Color x:Key="SoftBorderColor">#1C2038</Color>
    <Color x:Key="AccentColor">#A493FF</Color>
    <Color x:Key="HazardColor">#E0A85A</Color>
    <Color x:Key="PinkColor">#E07AB0</Color>
    <Color x:Key="DangerColor">#FF6B7A</Color>
    <Color x:Key="SuccessColor">#5FD39A</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource CardHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="{DynamicResource FaintTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="SoftBorderBrush" Color="{DynamicResource SoftBorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HazardBrush" Color="{DynamicResource HazardColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <FontFamily x:Key="HeadingFont">Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <CornerRadius x:Key="CornerRadiusBase">10</CornerRadius>
    <Color x:Key="TitleBarColor">#0B0E1C</Color>
    <Color x:Key="TitleBarTextColor">#E9EBF5</Color>
    <ImageBrush x:Key="WallpaperBrush" ImageSource="pack://application:,,,/Assets/Themes/studio.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0191D36" Offset="0"/><GradientStop Color="#F0101326" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarEdgeBrush" Color="#1C96A0FF"/>
    <LinearGradientBrush x:Key="ContentBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EB171B32" Offset="0"/><GradientStop Color="#EB0F1224" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="ContentEdgeBrush" Color="#1C96A0FF"/>
    <DropShadowEffect x:Key="PanelShadow" x:Shared="False" Color="#000000" BlurRadius="40" ShadowDepth="14" Opacity="0.55" Direction="270"/>
    <LinearGradientBrush x:Key="SidebarHeaderBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#09FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarHeaderEdgeBrush" Color="#1C96A0FF"/>
    <SolidColorBrush x:Key="SidebarHeaderInkBrush" Color="#E9EBF5"/>
    <LinearGradientBrush x:Key="FxBtnBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#252A46" Offset="0"/><GradientStop Color="#1A1E36" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxBtnEdgeBrush" Color="#14FFFFFF"/>
    <CornerRadius x:Key="FxBtnRadius">8</CornerRadius>
    <CornerRadius x:Key="FxTileRadius">12</CornerRadius>
    <SolidColorBrush x:Key="FxBtnSheenBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="FxBtnInkBrush" Color="#E9EBF5"/>
    <DropShadowEffect x:Key="FxBtnShadow" x:Shared="False" Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.45" Direction="270"/>
    <DropShadowEffect x:Key="FxBtnHoverEffect" x:Shared="False" Color="#000000" BlurRadius="8" ShadowDepth="3" Opacity="0.55" Direction="270"/>
    <SolidColorBrush x:Key="FxHoverWashBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="FxPressWashBrush" Color="#40000000"/>
    <TranslateTransform x:Key="FxPressTransform" X="0" Y="1"/>
    <LinearGradientBrush x:Key="FxPrimaryBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#927EFF" Offset="0"/><GradientStop Color="#5A45E6" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxPrimaryEdgeBrush" Color="#99BEAFFF"/>
    <SolidColorBrush x:Key="FxPrimaryInkBrush" Color="#FFFFFF"/>
    <DropShadowEffect x:Key="FxPrimaryShadow" x:Shared="False" Color="#6E50FF" BlurRadius="18" ShadowDepth="4" Opacity="0.45" Direction="270"/>
    <DropShadowEffect x:Key="FxPrimaryHoverEffect" x:Shared="False" Color="#6E50FF" BlurRadius="22" ShadowDepth="4" Opacity="0.7" Direction="270"/>
    <SolidColorBrush x:Key="FxRowBrush" Color="#05FFFFFF"/>
    <SolidColorBrush x:Key="FxRowEdgeBrush" Color="#00000000"/>
    <CornerRadius x:Key="FxRowRadius">8</CornerRadius>
    <SolidColorBrush x:Key="FxRowHoverBrush" Color="#0DFFFFFF"/>
    <LinearGradientBrush x:Key="FxSelectedBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3D8269FF" Offset="0"/><GradientStop Color="#295A46E6" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxSelectedEdgeBrush" Color="#A6A591FF"/>
    <SolidColorBrush x:Key="FxSelectedInkBrush" Color="#FFFFFF"/>
    <DropShadowEffect x:Key="FxSelectedGlow" x:Shared="False" Color="#6E50FF" BlurRadius="16" ShadowDepth="0" Opacity="0.3" Direction="270"/>
    <SolidColorBrush x:Key="FxFieldBrush" Color="#12152A"/>
    <SolidColorBrush x:Key="FxFieldEdgeBrush" Color="#2A2F52"/>
    <CornerRadius x:Key="FxFieldRadius">8</CornerRadius>
    <SolidColorBrush x:Key="FxFieldInkBrush" Color="#E9EBF5"/>
    <SolidColorBrush x:Key="FxFieldFocusBrush" Color="#927EFF"/>
    <DropShadowEffect x:Key="FxFieldFocusGlow" x:Shared="False" Color="#6E50FF" BlurRadius="12" ShadowDepth="0" Opacity="0.45" Direction="270"/>
    <SolidColorBrush x:Key="FxPopupBrush" Color="#161A30"/>
    <SolidColorBrush x:Key="FxPopupEdgeBrush" Color="#2A2F52"/>
    <CornerRadius x:Key="FxPopupRadius">10</CornerRadius>
    <DropShadowEffect x:Key="FxPopupShadow" x:Shared="False" Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.6" Direction="270"/>
    <SolidColorBrush x:Key="FxCheckBrush" Color="#12152A"/>
    <SolidColorBrush x:Key="FxCheckEdgeBrush" Color="#3A4070"/>
    <LinearGradientBrush x:Key="FxCheckOnBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#927EFF" Offset="0"/><GradientStop Color="#5A45E6" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="FxCheckOnEdgeBrush" Color="#A591FF"/>
    <SolidColorBrush x:Key="FxCheckMarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FxThumbBrush" Color="#3A4070"/>
    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A493FF" Offset="0"/><GradientStop Color="#5A45E6" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="TimerScreenBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0D1024" Offset="0"/><GradientStop Color="#070914" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="TimerScreenOverlayBrush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.8" RadiusY="1.1"><GradientStop Color="#387C5CFF" Offset="0"/><GradientStop Color="#007C5CFF" Offset="1"/></RadialGradientBrush>
    <SolidColorBrush x:Key="TimerScreenEdgeBrush" Color="#59A591FF"/>
    <Thickness x:Key="TimerScreenBorderThickness">1</Thickness>
    <CornerRadius x:Key="TimerScreenRadius">12</CornerRadius>
    <Thickness x:Key="TimerScreenPadding">22,6,22,8</Thickness>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#CFC7FF"/>
    <SolidColorBrush x:Key="TimerScreenInkBrush" Color="#8F88C8"/>
    <LinearGradientBrush x:Key="PopoutScreenBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0D1024" Offset="0"/><GradientStop Color="#070914" Offset="1"/></LinearGradientBrush>
    <DropShadowEffect x:Key="TimerGlow" x:Shared="False" Color="#7C5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.7" Direction="270"/>
    <FontFamily x:Key="TimerFont">Consolas</FontFamily>
</ResourceDictionary>
