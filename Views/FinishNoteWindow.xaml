<Window x:Class="BijouHub.Views.FinishNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Where did you leave off?" Height="380" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="// WHAT DID YOU DO?" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
        <TextBox x:Name="DidBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="// WHAT'S NEXT?" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6"/>
        <TextBox x:Name="NextBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Skip" Width="90" Margin="0,0,8,0" Click="Skip_Click"/>
            <Button Content="Save" Width="90" Style="{DynamicResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
