<Window x:Class="BijouHub.Views.BlackoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BijouHub.Views"
        Title="BijouHub Focus Screen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        WindowStartupLocation="Manual"
        Width="800" Height="450"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove" MouseLeftButtonDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel" SizeChanged="Window_SizeChanged">
    <Grid Background="Black">
        <!-- The timer, the plan under it, and what state it's in: nothing else. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Viewbox x:Name="TimeBox" MaxWidth="1400" MaxHeight="360" Stretch="Uniform" StretchDirection="DownOnly">
                <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="200" HorizontalAlignment="Center" Opacity="0.85"
                           FontFamily="{DynamicResource TimerFont}" FontWeight="{DynamicResource TimerFontWeight}"
                           Foreground="{DynamicResource TimerTextBrush}"/>
            </Viewbox>
            <TextBlock x:Name="GoalText" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,14,0,0"
                       Foreground="#8C96A3" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" FontSize="14" TextAlignment="Center" Margin="0,10,0,0" Foreground="#4C5560"/>
        </StackPanel>

        <!-- Tap the plain black and type something to do after: it goes into today's notes. -->
        <Border x:Name="NoteEntry" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="560" Margin="0,0,0,220" Padding="14,10"
                CornerRadius="10" Background="#14181D" BorderBrush="#232A33" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="For after this. Enter saves, Esc cancels." FontSize="12" Foreground="#6B7684" Margin="0,0,0,6"/>
                <TextBox x:Name="NoteInput" FontSize="18" Padding="8,6" KeyDown="NoteInput_KeyDown" AutomationProperties.Name="Quick note"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="NoteSaved" Text="Noted for after" FontSize="14" Foreground="#4C5560" Opacity="0" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,250"/>

        <!-- The notes so far: not there at all until the pointer is over this corner. -->
        <Border x:Name="NotesZone" HorizontalAlignment="Left" VerticalAlignment="Top" Width="380" Height="320" Background="Transparent"
                MouseEnter="NotesZone_Enter" MouseLeave="NotesZone_Leave">
            <StackPanel x:Name="NotesList" Margin="28,24,0,0" Opacity="0" IsHitTestVisible="False"/>
        </Border>

        <!-- Appear when the mouse moves, and go again after a few seconds. -->
        <Border x:Name="Controls" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Padding="14,10" CornerRadius="10"
                Background="#14181D" BorderBrush="#232A33" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <StackPanel>
            <StackPanel Orientation="Horizontal">
                <local:SessionTaskPicker x:Name="TaskPicker" Width="320" Margin="0,0,14,0"/>
                <Button x:Name="PauseButton" Content="Pause" Padding="12,6" Click="Pause_Click" AutomationProperties.Name="Blackout pause"/>
                <Button Content="Finish" Padding="12,6" Margin="8,0,0,0" Click="Finish_Click" AutomationProperties.Name="Blackout finish"/>
                <!-- One button per monitor; click one to move this there. -->
                <StackPanel x:Name="ScreenButtons" Orientation="Horizontal" Margin="8,0,0,0"/>
                <Button Content="Exit" Padding="12,6" Margin="8,0,0,0" Click="Exit_Click" AutomationProperties.Name="Blackout exit" ToolTip="Back to BijouHub (Esc)"/>
            </StackPanel>
            <!-- How the timer looks: size, font, color. Kept between sessions. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button Content="A−" Padding="10,4" Click="Smaller_Click" AutomationProperties.Name="Blackout smaller" ToolTip="Smaller timer (-, or scroll down)"/>
                <Button Content="A+" Padding="10,4" Margin="6,0,0,0" Click="Bigger_Click" AutomationProperties.Name="Blackout bigger" ToolTip="Bigger timer (+, or scroll up)"/>
                <ComboBox x:Name="FontBox" Width="170" Margin="14,0,14,0" AutomationProperties.Name="Blackout font" ToolTip="Timer font" SelectionChanged="Font_Changed"/>
                <StackPanel x:Name="Swatches" Orientation="Horizontal"/>
            </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
