<UserControl x:Class="BijouHub.Views.DuePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Quiet pill buttons for the quick picks and the month arrows. -->
        <Style x:Key="PickChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="10,3">
                            <ContentPresenter TextElement.FontSize="12" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One day in the month grid; Background/BorderBrush/Foreground are set per day. -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Hover" Fill="{DynamicResource CardHoverBrush}" Visibility="Hidden" Margin="2"/>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" Margin="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="12" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12,12,12,10" Width="264" Margin="0,4,0,0">
        <StackPanel>
            <WrapPanel x:Name="QuickPicks" Margin="0,0,0,4"/>

            <DockPanel Margin="2,4,2,6">
                <Button x:Name="PrevMonth" Style="{StaticResource PickChip}" Margin="0" Click="PrevMonth_Click" ToolTip="Previous month"
                        AutomationProperties.Name="Previous month" DockPanel.Dock="Left" Content="‹"/>
                <Button x:Name="NextMonth" Style="{StaticResource PickChip}" Margin="0" Click="NextMonth_Click" ToolTip="Next month"
                        AutomationProperties.Name="Next month" DockPanel.Dock="Right" Content="›"/>
                <TextBlock x:Name="MonthText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            </DockPanel>
            <UniformGrid x:Name="DayNames" Columns="7" Margin="0,0,0,2"/>
            <UniformGrid x:Name="DayGrid" Columns="7" Rows="6"/>

            <!-- Time: type it ("3pm", "15:30") or pick from the list. -->
            <Border Margin="0,8,0,0" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE823;" FontSize="14" Margin="2,0,8,0"
                                   Foreground="{DynamicResource MutedTextBrush}" DockPanel.Dock="Left"/>
                        <Button x:Name="ClearTimeButton" Style="{StaticResource PickChip}" Margin="6,0,0,0" DockPanel.Dock="Right"
                                Click="ClearTime_Click" ToolTip="No time" AutomationProperties.Name="Clear time" Content="✕" Visibility="Collapsed"/>
                        <Grid>
                            <TextBox x:Name="TimeBox" Padding="6,4" AutomationProperties.Name="Time"
                                     GotKeyboardFocus="TimeBox_GotKeyboardFocus" KeyDown="TimeBox_KeyDown" LostKeyboardFocus="TimeBox_LostKeyboardFocus"
                                     TextChanged="TimeBox_TextChanged"/>
                            <TextBlock x:Name="TimePlaceholder" Text="Add a time" Margin="9,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="13" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                    <ListBox x:Name="TimeList" Height="150" Margin="0,6,0,0" Visibility="Collapsed" Padding="2"
                             Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TimeList_SelectionChanged" AutomationProperties.Name="Times">
                        <!-- Compact rows, not the theme's big list cards. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="10,5">
                                                <ContentPresenter TextElement.FontSize="13"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
