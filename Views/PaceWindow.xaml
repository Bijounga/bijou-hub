<Window x:Class="BijouHub.Views.PaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pace" Height="330" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TaskText" Style="{StaticResource HeadingText}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="A steady step toward it. Time you put in with this task picked counts."/>

            <TextBlock Grid.Row="2" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="HOW MUCH"/></TextBlock>
            <TextBox Grid.Row="3" x:Name="AmountBox" Margin="0,0,0,12" AutomationProperties.Name="Pace amount" ToolTip="Like 1h, 45 or 1:30"/>

            <TextBlock Grid.Row="4" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="HOW OFTEN"/></TextBlock>
            <ComboBox Grid.Row="5" x:Name="RhythmBox" AutomationProperties.Name="Pace rhythm"/>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RemoveButton" Content="Remove pace" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Click="Remove_Click"/>
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Save" Width="80" Style="{DynamicResource AccentButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
