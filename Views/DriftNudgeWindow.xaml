<Window x:Class="BijouHub.Views.DriftNudgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="420" Height="140"
        Background="{DynamicResource PanelBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText" Grid.Row="1" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"/>

            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Not a distraction" Padding="0" FontSize="11" Click="NotDistraction_Click" Cursor="Hand"
                        VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Right" Content="Back to work" Padding="10,4" Style="{DynamicResource AccentButton}" Click="Back_Click"/>
                <Button DockPanel.Dock="Right" Content="Break" Padding="10,4" Margin="0,0,6,0" Click="Break_Click"/>
                <Button DockPanel.Dock="Right" Content="5 more min" Padding="10,4" Margin="0,0,6,0" Click="Snooze_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
