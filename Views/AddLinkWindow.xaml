<Window x:Class="BijouHub.Views.AddLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Link" Height="260" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource DotGridBrush}" IsHitTestVisible="False"/>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="URL" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Grid.Row="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Open with" Margin="0,0,0,4"/>
        <ComboBox x:Name="BrowserCombo" Grid.Row="3" Margin="0,0,0,12"
                  SelectionChanged="BrowserCombo_SelectionChanged"/>

        <TextBlock Grid.Row="4" Text="Profile (optional)" Margin="0,0,0,4"/>
        <ComboBox x:Name="ProfileCombo" Grid.Row="5" Margin="0,0,0,12" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Add" Width="80" Click="Add_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
