<Window x:Class="BijouHub.Views.SearchHideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hide from search" Width="460" Height="640" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Hide apps from search" Style="{StaticResource HeadingText}" FontSize="18" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12"
                           Text="A hidden app stops showing up when you type its name in Windows search. It still runs, and you can still open it from BijouHub. Tick the ones you want gone."/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="FilterBox" Padding="8,6" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Find an app"/>
                <TextBlock x:Name="FilterHint" Text="Find an app" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>

            <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <Button DockPanel.Dock="Right" Content="Close" Width="90" Style="{DynamicResource AccentButton}" Click="Close_Click"/>
                <Button x:Name="ShowAllButton" DockPanel.Dock="Left" Content="Show everything again" Padding="12,6" Click="ShowAll_Click"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
