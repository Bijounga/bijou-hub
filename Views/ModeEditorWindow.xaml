<Window x:Class="BijouHub.Views.ModeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Mode" Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource DotGridBrush}" IsHitTestVisible="False"/>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="// MODE NAME" Foreground="#9A9A9A" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,0,0,16" FontSize="16"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="// LAUNCH ITEMS" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="+ App" Margin="4,0,0,0" Click="AddApp_Click"/>
                    <Button Content="+ Folder" Margin="4,0,0,0" Click="AddFolder_Click"/>
                    <Button Content="+ File" Margin="4,0,0,0" Click="AddFile_Click"/>
                    <Button Content="+ Link" Margin="4,0,0,0" Click="AddLink_Click"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="LaunchItemsList" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⠿" Foreground="#5A6A7A" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding DelayMs, StringFormat='delay {0}ms'}"
                                       Foreground="#9A9A9A" Margin="8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="Set app..." Padding="6,2" Margin="2,0" Click="SetOpenWith_Click" Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Folder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="File">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="4" Content="Remove" Padding="6,2" Margin="2,0" Click="RemoveLaunchItem_Click" Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="3" Height="16"/>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="// BLOCKED WHILE THIS MODE IS ACTIVE" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Browse..." Margin="0,0,4,0" Click="BrowseBlock_Click"/>
                    <TextBox x:Name="BlockNameBox" Width="110" Margin="0,0,4,0" KeyDown="BlockNameBox_KeyDown"/>
                    <Button Content="+ Add" Click="AddBlock_Click"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="BlockItemsList" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⠿" Foreground="#5A6A7A" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="Remove" Padding="6,2" Click="RemoveBlockItem_Click" Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
