<Window x:Class="BijouHub.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Capture"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="560" SizeToContent="Height" WindowStartupLocation="Manual">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            CornerRadius="12" Padding="16,14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Click="Add_Click" Cursor="Hand" VerticalAlignment="Center" Margin="2,-2,12,0" ToolTip="Add" AutomationProperties.Name="Add task">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    <TextBlock Text="+" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                </Button>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Placeholder" Text="Capture a task" FontSize="16" Foreground="{DynamicResource FaintTextBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    <TextBox x:Name="TaskBox" FontSize="16" BorderThickness="0" Background="Transparent" Padding="0"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                             TextChanged="TaskBox_TextChanged" PreviewKeyDown="TaskBox_PreviewKeyDown"
                             AutomationProperties.Name="Task"/>
                </Grid>
                <ComboBox x:Name="ListCombo" Grid.Column="2" Width="170" Margin="12,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="List"/>
            </Grid>
            <TextBlock x:Name="HintText" Text="Enter to add to today  ·  Esc to close" FontSize="11"
                       Foreground="{DynamicResource FaintTextBrush}" Margin="36,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
