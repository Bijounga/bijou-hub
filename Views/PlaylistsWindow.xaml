<Window x:Class="BijouHub.Views.PlaylistsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlists" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource HeadingText}" FontSize="18" Text="Playlists" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Save a Spotify or YouTube playlist link here, then pick it when you start a timer: one to work to, and a calmer one for Pomodoro breaks. Pause it with your keyboard's pause key."/>

            <TextBlock Grid.Row="2" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="LINK"/></TextBlock>
            <DockPanel Grid.Row="3" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Add" Width="70" Margin="8,0,0,0" Click="Add_Click" AutomationProperties.Name="Add playlist"/>
                <TextBox x:Name="UrlBox" KeyDown="Box_KeyDown" AutomationProperties.Name="Playlist link"/>
            </DockPanel>
            <TextBox Grid.Row="4" x:Name="NameBox" Margin="0,0,0,14" KeyDown="Box_KeyDown" AutomationProperties.Name="Playlist name"
                     ToolTip="A name to pick it by (optional: it's named after the link otherwise)"/>

            <ListBox Grid.Row="5" x:Name="PlaylistList" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource GhostIconButton}" Padding="6,4" Click="Remove_Click" Tag="{Binding}"
                                    ToolTip="Remove" AutomationProperties.Name="Remove playlist">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE711;" FontSize="12"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource GhostIconButton}" Padding="6,4" Click="Play_Click" Tag="{Binding}"
                                    ToolTip="Play it now" AutomationProperties.Name="Play playlist">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="12"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="5" x:Name="EmptyText" Text="No playlists yet." Foreground="{DynamicResource FaintTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

            <Button Grid.Row="6" Content="Done" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" IsDefault="False" Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>
