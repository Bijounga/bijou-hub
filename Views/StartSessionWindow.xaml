<Window x:Class="BijouHub.Views.StartSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Session" Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ProjectNameText" Style="{StaticResource HeadingText}" FontSize="18" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="MODE FOR THIS SESSION"/></TextBlock>
        <ComboBox Grid.Row="2" x:Name="ModeCombo" Margin="0,0,0,16" SelectionChanged="ModeCombo_SelectionChanged"/>

        <TextBlock Grid.Row="3" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="WORKING ON"/></TextBlock>
        <ComboBox Grid.Row="4" x:Name="GoalCombo" Margin="0,0,0,16" DisplayMemberPath="Label"/>

        <TextBlock Grid.Row="5" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="TIMER"/></TextBlock>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="BudgetCombo" Width="190" SelectionChanged="BudgetCombo_SelectionChanged"/>
            <TextBox x:Name="CustomBudgetBox" Width="110" Margin="8,0,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <CheckBox Grid.Row="7" x:Name="CountDownCheckBox" Content="Count down instead of up" VerticalAlignment="Top" Margin="0,0,0,16"
                  IsEnabled="False" ToolTip="Show time remaining instead of time elapsed (needs a budget above)"/>

        <StackPanel Grid.Row="8">
            <TextBlock Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="MUSIC"/></TextBlock>
            <ComboBox x:Name="WorkMusicCombo" Margin="0,0,0,16" AutomationProperties.Name="Music while working"/>
            <StackPanel x:Name="BreakMusicPanel" Visibility="Collapsed">
                <TextBlock Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="BREAK MUSIC"/></TextBlock>
                <ComboBox x:Name="BreakMusicCombo" Margin="0,0,0,16" AutomationProperties.Name="Music on breaks"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="▶  Start" Width="100" Style="{DynamicResource AccentButton}" Click="Start_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
