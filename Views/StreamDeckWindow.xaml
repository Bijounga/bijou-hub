<Window x:Class="BijouHub.Views.StreamDeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Deck" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Stream Deck timers" Style="{StaticResource HeadingText}" FontSize="18" Margin="0,0,0,10"/>

            <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="1.  Install the plugin, then drag a BijouHub Timer onto a key."/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="2.  In the key's settings, pick a mode and a duration — 45, 1:30, 2h. Leave the duration empty to count up."/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="3.  Tap to start, tap again to pause, hold to finish. The key counts down live."/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"
                           Text="Timers you start from the deck are logged like any session. Assign them to a project later from the Session Log."/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="InstallButton" Content="Install Plugin" Margin="0,0,8,0" Padding="16,6" Click="Install_Click"/>
                <Button Content="Close" Width="90" Style="{DynamicResource AccentButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
