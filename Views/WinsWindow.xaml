<Window x:Class="BijouHub.Views.WinsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session done" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="Headline" Style="{StaticResource HeadingText}" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="Context" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <StackPanel x:Name="LinesPanel" Margin="0,0,0,18"/>
            <DockPanel LastChildFill="False">
                <CheckBox x:Name="KeepShowing" DockPanel.Dock="Left" Content="Show this after sessions" IsChecked="True" VerticalAlignment="Center"
                          Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                <Button DockPanel.Dock="Right" Content="Nice" Width="90" Style="{DynamicResource AccentButton}" IsDefault="True" IsCancel="True" Click="Close_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
