<Window x:Class="BijouHub.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Project" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="PROJECT NAME" Foreground="#9A9A9A" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" FontSize="16"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="LINKED MODE" Foreground="#9A9A9A" Margin="0,0,0,4"/>
                <ComboBox x:Name="ModeCombo" DisplayMemberPath="Name"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="DEFAULT SESSION BUDGET (MINUTES, OPTIONAL)" Foreground="#9A9A9A" Margin="0,0,0,4"/>
            <TextBox x:Name="BudgetBox" Width="120" HorizontalAlignment="Left"/>
        </StackPanel>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,6">
            <TextBlock Text="GOALS" Foreground="#9A9A9A" VerticalAlignment="Center"/>
            <Button Content="+ Goal" DockPanel.Dock="Right" Click="AddGoal_Click"/>
        </DockPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="GoalsList" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⠿" Foreground="#5A6A7A" Margin="0,0,8,0"
                                               VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsComplete}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SubGoals.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Weight %"/>
                                    <Button Grid.Column="4" Content="+ Sub" Padding="6,2" Margin="0,0,4,0" Click="AddSubGoal_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="5" Content="Remove" Padding="6,2" Click="RemoveGoal_Click" Tag="{Binding}"/>
                                </Grid>

                                <ListBox x:Name="SubGoalsList" ItemsSource="{Binding SubGoals}" Margin="34,8,0,0"
                                         BorderThickness="0" Background="Transparent"
                                         Loaded="SubGoalsList_Loaded" Tag="{Binding}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⠿" Foreground="#5A6A7A" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsComplete}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Weight %"/>
                                                <Button Grid.Column="4" Content="Remove" Padding="6,2" Click="RemoveSubGoal_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
