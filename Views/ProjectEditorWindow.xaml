<Window x:Class="BijouHub.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Project" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <Rectangle Fill="{DynamicResource DotGridBrush}" Visibility="{DynamicResource ClassicChromeVisibility}" IsHitTestVisible="False"/>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="PROJECT NAME"/></TextBlock>
                <TextBox x:Name="NameBox" FontSize="16"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="LINKED MODE"/></TextBlock>
                <ComboBox x:Name="ModeCombo" DisplayMemberPath="Name"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="DEFAULT SESSION BUDGET (MINUTES, OPTIONAL)"/></TextBlock>
                <TextBox x:Name="BudgetBox" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <TextBlock Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,4"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="CHANNEL"/></TextBlock>
                <DockPanel>
                    <Button Content="Manage…" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" Click="ManageChannels_Click" AutomationProperties.Name="Manage channels"/>
                    <ComboBox x:Name="ChannelCombo" AutomationProperties.Name="Channel">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Color}"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,6">
            <TextBlock Foreground="{DynamicResource SectionLabelBrush}" VerticalAlignment="Center"><Run Text="{DynamicResource SectionPrefix}"/><Run Text="GOALS"/></TextBlock>
            <Button Content="+ Goal" DockPanel.Dock="Right" Click="AddGoal_Click"/>
        </DockPanel>

        <ScrollViewer x:Name="GoalsScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="GoalsList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseWheel="GoalsList_PreviewMouseWheel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusBase}" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⠿" Foreground="{DynamicResource DragHandleBrush}" Margin="0,0,8,0"
                                               VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsComplete}" Margin="0,0,8,0" VerticalAlignment="Center"
                                              Visibility="{Binding SubGoals.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    <TextBox Grid.Column="2" x:Name="GoalNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center"
                                             KeyDown="GoalNameBox_KeyDown"/>
                                    <TextBox Grid.Column="3" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Weight %" LostFocus="WeightBox_LostFocus"/>
                                    <Button Grid.Column="4" Content="+ Sub" Padding="6,2" Margin="0,0,4,0" Click="AddSubGoal_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="5" Content="Remove" Padding="6,2" Click="RemoveGoal_Click" Tag="{Binding}"/>
                                </Grid>

                                <ListBox x:Name="SubGoalsList" ItemsSource="{Binding SubGoals}" Margin="34,8,0,0"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Loaded="SubGoalsList_Loaded" Tag="{Binding}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⠿" Foreground="{DynamicResource DragHandleBrush}" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsComplete}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2" x:Name="SubGoalNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         KeyDown="SubGoalNameBox_KeyDown"/>
                                                <TextBox Grid.Column="3" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Weight %" LostFocus="WeightBox_LostFocus"/>
                                                <Button Grid.Column="4" Content="Remove" Padding="6,2" Click="RemoveSubGoal_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Style="{DynamicResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
