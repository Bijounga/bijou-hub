<Window x:Class="BijouHub.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="420" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource BgBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="19" MaxWidth="460" HorizontalAlignment="Left"/>
        <!-- Cancel on the left; the choices on the right, the last one the strongest. -->
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button Content="Cancel" MinWidth="80" Padding="12,6" Click="Cancel_Click" IsCancel="True"/>
            <StackPanel x:Name="Choices" Orientation="Horizontal" DockPanel.Dock="Right"/>
        </DockPanel>
    </StackPanel>
</Window>
