<Window x:Class="BijouHub.Views.KeybindsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes Keybinds" Height="360" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource DotGridBrush}" IsHitTestVisible="False"/>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Click a field, then press the new key combo." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12"/>

        <StackPanel x:Name="RowsPanel" Grid.Row="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset defaults" Margin="0,0,8,0" Click="ResetDefaults_Click"/>
            <Button Content="Close" Width="90" Style="{StaticResource AccentButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
