<Window x:Class="BijouHub.Views.KeyLightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elgato Key Light" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource BgBrush}">
    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="Switch your Key Light on when a session starts in a mode that has it ticked. It talks to the light over your home network; nothing goes online."
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/>

        <TextBlock Text="LIGHT'S ADDRESS" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
        <DockPanel>
            <Button x:Name="FindButton" Content="Find my light" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Click="Find_Click" AutomationProperties.Name="Find my light"/>
            <TextBox x:Name="AddressBox" AutomationProperties.AutomationId="AddressBox" AutomationProperties.Name="Light address" Padding="8,6"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Press Find my light, or type its address (like 192.168.1.40)."/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="TestOnButton" Content="Turn on" Padding="12,6" Click="TestOn_Click" AutomationProperties.Name="Test turn on"/>
            <Button x:Name="TestOffButton" Content="Turn off" Padding="12,6" Margin="8,0,0,0" Click="TestOff_Click" AutomationProperties.Name="Test turn off"/>
        </StackPanel>

        <CheckBox x:Name="OffBox" Content="Turn it off again when the session ends" Margin="0,16,0,0" AutomationProperties.AutomationId="OffBox"/>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button Content="Cancel" MinWidth="80" Padding="12,6" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Save" MinWidth="90" Padding="12,6" DockPanel.Dock="Right" Click="Save_Click" Style="{DynamicResource AccentButton}" AutomationProperties.Name="Save"/>
        </DockPanel>
    </StackPanel>
</Window>
