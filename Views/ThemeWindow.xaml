<Window x:Class="BijouHub.Views.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme" Height="600" Width="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose a theme — it applies immediately." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12"/>

        <ListBox x:Name="ThemesList" Grid.Row="1" SelectionChanged="ThemesList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Two-tone swatch: the theme's base and its accent. -->
                        <Border Grid.Column="0" Width="30" Height="18" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True"
                                VerticalAlignment="Center" BorderBrush="#40000000" BorderThickness="1" Background="{Binding Base}">
                            <Border Width="11" HorizontalAlignment="Right" CornerRadius="0,3,3,0" Background="{Binding Accent}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Close" Width="90" HorizontalAlignment="Right"
                Style="{DynamicResource AccentButton}" Margin="0,16,0,0" Click="Close_Click"/>
    </Grid>
</Window>
