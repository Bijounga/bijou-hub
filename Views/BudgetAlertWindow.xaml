<Window x:Class="BijouHub.Views.BudgetAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="340" Height="132"
        Background="{StaticResource PanelBrush}">
    <Border BorderBrush="{StaticResource HazardBrush}" BorderThickness="2">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Top"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Extend 15 min" Margin="0,0,8,0" Padding="10,4" Click="Extend_Click"/>
                <Button Content="Finish now" Padding="10,4" Click="FinishNow_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
