<Window x:Class="BijouHub.Views.TimerPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="190" Height="120"
        MinWidth="120" MinHeight="76"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#33E1FF" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <Viewbox Stretch="Uniform" Margin="14,10,14,12">
            <Grid Width="220">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock x:Name="NameText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="✕" Cursor="Hand" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" MouseLeftButtonDown="Close_Click" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,2,0,2">
                    <TextBlock Text="{Binding Text, ElementName=TimerText}" Style="{StaticResource HeadingText}" FontSize="34"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#33E1FF" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TimerText" Style="{StaticResource HeadingText}" Text="00:00:00" FontSize="34"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Finish" Padding="10,4" Click="Finish_Click"/>
                    <Button Content="Dock" Margin="8,0,0,0" Padding="10,4" Click="Dock_Click"/>
                </StackPanel>
            </Grid>
            </Viewbox>
        </Border>

        <Thumb x:Name="ResizeThumb" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" Background="Transparent" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M13,3 L13,13 L3,13 M13,7.5 L13,13 L7.5,13 M13,11 L13,13 L11,13"
                              Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
