<Window x:Class="BijouHub.Views.TimerPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="260" Height="168"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#33E1FF" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                <TextBlock x:Name="NameText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="✕" Cursor="Hand" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" MouseLeftButtonDown="Close_Click" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="TimerText" Grid.Row="1" Style="{StaticResource HeadingText}" Text="00:00:00" FontSize="34"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#33E1FF" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Finish" Padding="10,4" Click="Finish_Click"/>
                <Button Content="Dock" Margin="8,0,0,0" Padding="10,4" Click="Dock_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
